{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/404/?$",
			"dest": "_render"
		},
		{
			"src": "^/contacto/?$",
			"dest": "_render"
		},
		{
			"src": "^/legal/aviso-legal/?$",
			"dest": "_render"
		},
		{
			"src": "^/legal/politica-cookies/?$",
			"dest": "_render"
		},
		{
			"src": "^/legal/politica-privacidad/?$",
			"dest": "_render"
		},
		{
			"src": "^/proyectos/?$",
			"dest": "_render"
		},
		{
			"src": "^/servicios/?$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap-0\\.xml/?$",
			"dest": "_render"
		},
		{
			"src": "^/sitemap-index\\.xml/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		},
		{
			"src": "^/.*$",
			"dest": "_render",
			"status": 404
		}
	]
}
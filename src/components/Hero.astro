---
// src/components/Hero.astro
---

<header class="hero-section">
    <div class="hero-bg-glow"></div>

    <div class="container fluid-height">
        <div class="hero-content">
            <div class="label-wrapper fade-in-up">
                <span class="status-dot"></span>
                <span class="status-text">Agencia Digital en Sevilla</span>
            </div>

            <h1 class="mega-title">
                <div class="line"><span class="reveal-text">DISEÑO</span></div>
                <div class="line"><span class="reveal-text outline-text">WEB &</span></div>
                <div class="line indent"><span class="reveal-text">AUTORIDAD</span></div>
            </h1>

            <div class="hero-footer fade-in-up delay-2">
                <p class="hero-desc">
                    No hacemos simples páginas web.
                    Creamos <strong>activos digitales</strong> diseñados con
                    psicología de venta y automatización para que tu negocio en Sevilla (o el mundo) no pare de
                    crecer.
                </p>
                
                <a href="/proyectos" class="scroll-down-btn magnet-target">
                    <div class="arrow-wrapper">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <polyline points="19 12 12 19 5 12"></polyline>
                        </svg>
                    </div>
                    <span class="btn-text">Ver casos de éxito</span>
                </a>
            </div>
        </div>
    </div>
</header>

<style>
    /* Estilos Base */
    .hero-section { 
        min-height: 100vh;
        min-height: 100dvh;
        width: 100%;
        display: flex; 
        align-items: center;
        justify-content: center;
        position: relative; 
        overflow: hidden; 
        padding-top: 80px;
        padding-bottom: 50px;
    }

    .hero-bg-glow {
        position: absolute; 
        width: 800px; height: 800px;
        background: radial-gradient(circle, var(--accent-color) 0%, transparent 60%);
        opacity: 0.15; 
        filter: blur(80px); 
        top: 50%; left: 50%; 
        transform: translate(-50%, -50%);
        animation: pulseGlow 8s infinite alternate;
        z-index: 0;
    }
    
    @keyframes pulseGlow { 
        0% { opacity: 0.15; transform: translate(-50%, -50%) scale(1); } 
        100% { opacity: 0.25; transform: translate(-50%, -50%) scale(1.2); } 
    }

    .fluid-height { 
        height: 100%;
        display: flex;
        flex-direction: column; 
        justify-content: center; 
        position: relative;
        z-index: 1;
    }

    .mega-title {
        font-family: 'Syne', sans-serif;
        font-size: clamp(3rem, 8vw, 8.5rem); 
        line-height: 1.1;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--white);
        margin-bottom: 40px;
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        width: 100%;
    }
    
    .line {
        display: block;
        padding: 5px 0; 
        overflow: visible;
        white-space: nowrap;
    }

    .line.indent { margin-left: 5vw; }

    /* Animación de entrada */
    .reveal-text { 
        display: block;
        transform: translateY(120%); 
        transition: transform 1.2s cubic-bezier(0.19, 1, 0.22, 1); 
    }
    
    :global(body.loaded) .reveal-text { transform: translateY(0); }

    .outline-text { 
        -webkit-text-stroke: 1px var(--white); 
        color: transparent;
        transition: 0.3s;
    }
    
    .mega-title:hover .outline-text { 
        color: var(--accent-color);
        -webkit-text-stroke: 0; 
    }

    .label-wrapper { 
        display: inline-flex;
        align-items: center;
        gap: 10px; 
        border: 1px solid rgba(255,255,255,0.2); 
        padding: 8px 16px; 
        border-radius: 50px; 
        margin-bottom: 30px; 
        font-size: 0.8rem; 
        text-transform: uppercase;
        letter-spacing: 1px;
        width: fit-content;
    }
    
    .status-dot { 
        width: 8px;
        height: 8px; background: #00ff88;
        border-radius: 50%;
        box-shadow: 0 0 10px #00ff88;
    }

    .hero-footer { 
        display: flex;
        justify-content: space-between; 
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 30px; 
    }
    
    .hero-desc { 
        max-width: 400px;
        color: var(--gray); 
        font-size: 1.1rem; 
        line-height: 1.6;
    }
    
    /* --- ESTILOS DEL BOTÓN / LINK (DESKTOP BASE) --- */
    
    .scroll-down-btn { 
        display: flex;
        align-items: center; 
        gap: 15px; 
        color: var(--white); 
        text-decoration: none; 
        opacity: 0.8; 
        transition: all 0.3s ease;
        position: relative;
    }
    
    /* Círculo de la flecha en Desktop */
    .arrow-wrapper { 
        width: 44px;
        height: 44px;
        border: 1px solid rgba(255,255,255,0.3); 
        border-radius: 50%; 
        display: flex; 
        align-items: center; 
        justify-content: center;
        transition: 0.3s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .arrow-wrapper svg {
        transition: transform 0.3s ease;
    }

    /* Hover Desktop */
    .scroll-down-btn:hover { 
        opacity: 1;
    }
    
    .scroll-down-btn:hover .arrow-wrapper {
        border-color: var(--accent-color);
        background: rgba(255, 255, 255, 0.05);
        transform: scale(1.1);
    }
    
    .scroll-down-btn:hover .arrow-wrapper svg {
        transform: translateY(3px); /* Pequeño rebote de la flecha */
    }

    /* --- MEDIA QUERIES --- */

    @media (min-width: 1200px) {
        .line.indent { margin-left: 10vw; }
    }

    @media (max-width: 1024px) {
        .line.indent { margin-left: 0; }
        .mega-title { font-size: 7vw; }
    }

    /* === MÓVIL (EL BOTÓN CHULO) === */
    @media (max-width: 768px) {
        .hero-section {
            padding-top: 110px;
            align-items: flex-start; 
        }

        .fluid-height {
            justify-content: flex-start;
            padding-top: 20px;
        }

        .mega-title {
            font-size: 9vw;
            margin-bottom: 30px;
        }
        
        .line.indent { margin-left: 0 !important; }

        .hero-footer { 
            flex-direction: column;
            align-items: flex-start; 
            gap: 25px;
            margin-top: auto;
            padding-bottom: 40px; 
        }
        
        .hero-desc { 
            font-size: 1rem;
            width: 100%;
        }

        .label-wrapper {
            margin-bottom: 20px;
            font-size: 0.75rem;
        }

        /* --- TRANSFORMACIÓN SUPER-CHULA DEL BOTÓN EN MÓVIL --- */
        .scroll-down-btn {
            /* Base con gradiente potente */
            background: var(--primary-gradient); 
            width: 100%; 
            justify-content: center;
            padding: 18px 24px; /* Un poco más alto */
            border-radius: 50px; 
            opacity: 1; 
            
            /* Tipografía más fuerte */
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            font-size: 0.95rem;
            text-shadow: 0 2px 4px rgba(0,0,0,0.2); /* Sombra sutil al texto para que salte */

            /* Efectos de profundidad y luz */
            border: 1px solid rgba(255, 255, 255, 0.15); /* Borde fino para definir */
            box-shadow: 
                0 10px 30px -10px rgba(168, 85, 247, 0.6), /* Sombra difusa de neón abajo */
                inset 0 0 20px rgba(255, 255, 255, 0.2); /* Luz interior */
            
            position: relative;
            overflow: hidden; /* Necesario para el efecto de brillo */
            z-index: 10;
        }

        /* Animación de "reflejo de luz" pasando por el botón */
        .scroll-down-btn::after {
            content: '';
            position: absolute;
            top: -50%; right: -50%; bottom: -50%; left: -50%;
            background: linear-gradient(to bottom, rgba(255,255,255,0), rgba(255,255,255,0.5) 50%, rgba(255,255,255,0));
            transform: rotateZ(60deg) translate(-5em, 7.5em);
            opacity: 0;
            animation: sheen 5s infinite ease-in-out;
            z-index: -1;
        }
        
        /* Animación del brillo */
        @keyframes sheen {
            0%, 70% { opacity: 0; transform: rotateZ(60deg) translate(-5em, 7.5em); }
            75% { opacity: 0.3; }
            100% { opacity: 0; transform: rotateZ(60deg) translate(1em, -9em); }
        }

        /* Estado activo (al tocar con el dedo) */
        .scroll-down-btn:active {
            transform: scale(0.97) translateY(2px); /* Efecto de presión físico */
            box-shadow: 
                0 5px 15px -5px rgba(168, 85, 247, 0.8), /* Sombra más intensa y corta */
                inset 0 0 10px rgba(0, 0, 0, 0.2); /* Sombra interior para hundirlo */
        }

        /* Ajustes internos del botón en móvil */
        .arrow-wrapper {
            border: none;
            width: auto;
            height: auto;
            margin-right: 0; 
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.2)); /* Sombra al icono también */
        }
        
        /* Rotamos la flecha para que apunte a la derecha, invitando a la acción */
        .arrow-wrapper svg {
            transform: rotate(-90deg);
            width: 22px;
            height: 22px;
        }
    }
    
    @media (max-width: 380px) {
        .mega-title { font-size: 8.5vw; }
    }
</style>
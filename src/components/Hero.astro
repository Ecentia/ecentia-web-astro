---
// src/components/Hero.astro
---

<header class="hero-section">
    <div class="hero-bg-glow"></div>

    <div class="container fluid-height">
        <div class="hero-content">
            <div class="label-wrapper fade-in-up">
                <span class="status-dot"></span>
                <span class="status-text">Agencia Digital en Sevilla</span>
            </div>

            <h1 class="mega-title">
                <div class="line"><span class="reveal-text">DISEÑO</span></div>
                <div class="line"><span class="reveal-text outline-text">WEB &</span></div>
                <div class="line indent"><span class="reveal-text">AUTORIDAD</span></div>
            </h1>

            <div class="hero-footer fade-in-up delay-2">
                <p class="hero-desc">
                    No hacemos simples páginas web.
                    Creamos <strong>activos digitales</strong> diseñados con
                    psicología de venta y automatización para que tu negocio en Sevilla (o el mundo) no pare de
                    crecer.
                </p>
                <a href="/proyectos" class="scroll-down-btn magnet-target">
                    <div class="arrow-down"><i class="fas fa-arrow-down"></i></div>
                    <span>Ver casos de éxito</span>
                </a>
            </div>
        </div>
    </div>
</header>

<style>
    /* Estilos Base */
    .hero-section { 
        min-height: 100vh;
        min-height: 100dvh; /* Soporte móvil moderno */
        width: 100%;
        display: flex; 
        align-items: center; 
        justify-content: center;
        position: relative; 
        overflow: hidden; 
        padding-top: 80px;
        padding-bottom: 50px;
    }

    .hero-bg-glow {
        position: absolute; 
        width: 800px; height: 800px;
        background: radial-gradient(circle, var(--accent-color) 0%, transparent 60%);
        opacity: 0.15; 
        filter: blur(80px); 
        top: 50%; left: 50%; 
        transform: translate(-50%, -50%);
        animation: pulseGlow 8s infinite alternate;
        z-index: 0;
    }
    
    @keyframes pulseGlow { 
        0% { opacity: 0.15; transform: translate(-50%, -50%) scale(1); } 
        100% { opacity: 0.25; transform: translate(-50%, -50%) scale(1.2); } 
    }

    .fluid-height { 
        height: 100%;
        display: flex;
        flex-direction: column; 
        justify-content: center; 
        position: relative;
        z-index: 1;
    }

    .mega-title {
        font-family: 'Syne', sans-serif;
        /* Desktop: fluido pero controlado */
        font-size: clamp(3rem, 8vw, 8.5rem); 
        line-height: 1.1; 
        font-weight: 800;
        text-transform: uppercase;
        color: var(--white);
        margin-bottom: 40px;
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        width: 100%;
    }
    
    .line {
        display: block;
        padding: 5px 0; 
        overflow: visible;
        /* IMPORTANTE: Evita que el navegador rompa la palabra si falta espacio */
        white-space: nowrap; 
    }

    .line.indent { 
        margin-left: 5vw;
    }

    /* Animación de entrada */
    .reveal-text { 
        display: block;
        transform: translateY(120%); 
        transition: transform 1.2s cubic-bezier(0.19, 1, 0.22, 1); 
    }
    
    :global(body.loaded) .reveal-text { 
        transform: translateY(0);
    }

    .outline-text { 
        -webkit-text-stroke: 1px var(--white); 
        color: transparent;
        transition: 0.3s;
    }
    
    .mega-title:hover .outline-text { 
        color: var(--accent-color);
        -webkit-text-stroke: 0; 
    }

    .label-wrapper { 
        display: inline-flex;
        align-items: center;
        gap: 10px; 
        border: 1px solid rgba(255,255,255,0.2); 
        padding: 8px 16px; 
        border-radius: 50px; 
        margin-bottom: 30px; 
        font-size: 0.8rem; 
        text-transform: uppercase;
        letter-spacing: 1px;
        width: fit-content;
    }
    
    .status-dot { 
        width: 8px; height: 8px; background: #00ff88;
        border-radius: 50%;
        box-shadow: 0 0 10px #00ff88; 
    }

    .hero-footer { 
        display: flex;
        justify-content: space-between; 
        align-items: flex-end; 
        flex-wrap: wrap;
        gap: 30px; 
    }
    
    .hero-desc { 
        max-width: 400px;
        color: var(--gray); 
        font-size: 1.1rem; 
        line-height: 1.6;
    }
    
    .scroll-down-btn { 
        display: flex;
        align-items: center; 
        gap: 15px; 
        color: var(--white); 
        text-decoration: none; 
        opacity: 0.7; 
        transition: 0.3s;
    }
    
    .scroll-down-btn:hover { opacity: 1; }
    
    .arrow-down { 
        width: 40px; height: 40px;
        border: 1px solid rgba(255,255,255,0.3); 
        border-radius: 50%; 
        display: flex; align-items: center; justify-content: center;
    }

    /* --- MEDIA QUERIES --- */

    @media (min-width: 1200px) {
        .line.indent { margin-left: 10vw; }
    }

    @media (max-width: 1024px) {
        .line.indent { margin-left: 0; }
        .mega-title { font-size: 7vw; }
    }

    /* MÓVIL (Portrait) */
    @media (max-width: 768px) {
        .hero-section {
            padding-top: 110px; 
            align-items: flex-start; 
        }

        .fluid-height {
            justify-content: flex-start;
            padding-top: 20px;
        }

        .mega-title {
            /* AJUSTE CRÍTICO: 9vw asegura que AUTORIDAD quepa sin romperse */
            font-size: 9vw; 
            line-height: 1.1;
            margin-bottom: 30px;
        }
        
        .line.indent { 
            /* Forzar margen 0 en móvil */
            margin-left: 0 !important; 
        }

        .hero-footer { 
            flex-direction: column;
            align-items: flex-start; 
            gap: 25px;
            margin-top: auto;
            padding-bottom: 30px;
        }
        
        .hero-desc { 
            font-size: 1rem; 
            width: 100%;
        }

        .label-wrapper {
            margin-bottom: 20px;
            font-size: 0.75rem;
        }
    }
    
    /* MÓVILES MUY PEQUEÑOS */
    @media (max-width: 380px) {
        .mega-title {
            /* Si la pantalla es diminuta, bajamos un poco más */
            font-size: 8.5vw; 
        }
    }
</style>
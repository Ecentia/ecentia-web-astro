---
// src/components/Hero.astro
---

<header class="hero-section">
    <div class="hero-bg-glow"></div>

    <div class="container fluid-height">
        <div class="hero-content">
            <div class="label-wrapper fade-in-up">
                <span class="status-dot"></span>
                <span class="status-text">Diseño y Desarrollo Web a Medida</span>
            </div>

            <h1 class="mega-title">
                <div class="line"><span class="reveal-text">PÁGINAS</span></div>
                <div class="line"><span class="reveal-text">WEB</span></div>
                <div class="line"><span class="reveal-text outline-text">PARA</span></div>
                <div class="line"><span class="reveal-text outline-text">TU</span></div>
                <div class="line indent"><span class="reveal-text">NEGOCIO</span></div>
            </h1>

            <div class="hero-body fade-in-up delay-1">
                <p class="hero-desc">
                    Hacemos páginas web en <strong>WordPress, Shopify y código a medida</strong>.
                    Con base en Sevilla, trabajamos con negocios de <strong>toda España y Portugal</strong>,
                    100% en remoto. Rápidas, modernas y diseñadas para que te encuentren en Google.
                </p>
            </div>

            <div class="hero-stats fade-in-up delay-15">
                <div class="stat-item">
                    <span class="stat-num">A medida</span>
                    <span class="stat-label">Según tu proyecto</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <span class="stat-num">24h</span>
                    <span class="stat-label">Presupuesto gratis</span>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <span class="stat-num">WP · Shopify</span>
                    <span class="stat-label">Y código a medida</span>
                </div>
            </div>

            <div class="hero-footer fade-in-up delay-2">
                <a href="/contacto" class="btn-primary-cta magnet-target" aria-label="Pedir presupuesto gratis de página web en Sevilla sin compromiso">
                    <div class="arrow-circle">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <line x1="12" y1="5" x2="12" y2="19"></line>
                            <polyline points="19 12 12 19 5 12"></polyline>
                        </svg>
                    </div>
                    <span>Pedir presupuesto gratis</span>
                </a>
                <a href="/proyectos" class="btn-outline-cta magnet-target" aria-label="Ver proyectos de diseño web realizados">
                    <span>Ver proyectos</span>
                    <i class="fas fa-arrow-right"></i>
                </a>
            </div>
        </div>
    </div>
</header>

<style>
    /* Estilos Base */
    .hero-section { 
        min-height: 100vh;
        min-height: 100dvh;
        width: 100%;
        display: flex; 
        align-items: center;
        justify-content: center;
        position: relative; 
        overflow: hidden; 
        padding-top: 80px;
        padding-bottom: 50px;
    }

    .hero-bg-glow {
        position: absolute; 
        width: 800px; height: 800px;
        background: radial-gradient(circle, var(--accent-color) 0%, transparent 60%);
        opacity: 0.15; 
        filter: blur(80px); 
        top: 50%; left: 50%; 
        transform: translate(-50%, -50%);
        animation: pulseGlow 8s infinite alternate;
        z-index: 0;
    }
    
    @keyframes pulseGlow { 
        0% { opacity: 0.15; transform: translate(-50%, -50%) scale(1); } 
        100% { opacity: 0.25; transform: translate(-50%, -50%) scale(1.2); } 
    }

    .fluid-height { 
        height: 100%;
        display: flex;
        flex-direction: column; 
        justify-content: center; 
        position: relative;
        z-index: 1;
    }

    .mega-title {
        font-family: 'Syne', sans-serif;
        font-size: clamp(3rem, 9.2vw, 8.5rem);
        line-height: 0.95;
        font-weight: 800;
        text-transform: uppercase;
        color: var(--white);
        margin-bottom: 40px;
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        width: 100%;
        /* Blindaje anti-overflow */
        overflow: hidden;
        max-width: 100%;
    }
    
    .line {
        display: block;
        padding: 4px 0; 
        overflow: hidden;
        white-space: nowrap;
        max-width: 100%;
    }

    /* En móvil evitamos saltos de línea para mantener las palabras completas */
    @media (max-width: 480px) {
        .line { white-space: nowrap; }
    }

    .line.indent { margin-left: 4vw; }

    /* Animación de entrada */
    .reveal-text { 
        display: block;
        transform: translateY(120%); 
        transition: transform 1.2s cubic-bezier(0.19, 1, 0.22, 1); 
    }
    
    :global(body.loaded) .reveal-text { transform: translateY(0); }

    .outline-text { 
        -webkit-text-stroke: 1px var(--white); 
        color: transparent;
        transition: 0.3s;
    }
    
    .mega-title:hover .outline-text { 
        color: var(--accent-color);
        -webkit-text-stroke: 0; 
    }

    .label-wrapper { 
        display: inline-flex;
        align-items: center;
        gap: 10px; 
        border: 1px solid rgba(255,255,255,0.2); 
        padding: 8px 16px; 
        border-radius: 50px; 
        margin-bottom: 30px; 
        font-size: 0.8rem; 
        text-transform: uppercase;
        letter-spacing: 1px;
        width: fit-content;
    }
    
    .status-dot { 
        width: 8px;
        height: 8px; background: #00ff88;
        border-radius: 50%;
        box-shadow: 0 0 10px #00ff88;
    }

    .hero-body {
        margin-bottom: 40px;
    }

    .hero-footer { 
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px; 
    }
    
    .hero-desc { 
        max-width: 480px;
        color: var(--gray); 
        font-size: 1.1rem; 
        line-height: 1.6;
    }

    /* Stats bar */
    .hero-stats {
        display: flex;
        align-items: center;
        gap: 30px;
        margin-bottom: 40px;
        padding: 20px 30px;
        background: rgba(255,255,255,0.03);
        border: 1px solid rgba(255,255,255,0.08);
        border-radius: 12px;
        width: fit-content;
    }

    .stat-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
    }

    .stat-num {
        font-family: 'Syne', sans-serif;
        font-size: 1.6rem;
        font-weight: 800;
        color: var(--white);
        line-height: 1;
    }

    .stat-label {
        font-size: 0.75rem;
        color: var(--gray);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        text-align: center;
    }

    .stat-divider {
        width: 1px;
        height: 40px;
        background: rgba(255,255,255,0.1);
    }

    /* ================================================
       CTAs DEL HERO — ESTILO MINIMAL
    ================================================ */

    .hero-footer {
        display: flex;
        align-items: center;
        gap: 28px;
        flex-wrap: wrap;
    }

    /* ---- Botón PRIMARIO: círculo relleno + texto + animaciones ---- */
    .btn-primary-cta {
        display: inline-flex;
        align-items: center;
        gap: 14px;
        color: var(--white);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.2px;
        transition: all 0.3s ease;
        opacity: 0.9;
    }

    /* Círculo con la flecha */
    .arrow-circle {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: var(--accent-color);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: all 0.3s cubic-bezier(0.19, 1, 0.22, 1);
        box-shadow: 0 4px 20px -4px rgba(168, 85, 247, 0.5);
    }

    .arrow-circle svg { transition: transform 0.3s ease; }

    /* Texto del botón primario con subrayado animado */
    .btn-primary-cta span {
        position: relative;
    }

    .btn-primary-cta span::after {
        content: '';
        position: absolute;
        bottom: -2px;
        left: 0;
        width: 0;
        height: 1.5px;
        background: var(--white);
        transition: width 0.4s cubic-bezier(0.19, 1, 0.22, 1);
    }

    /* Keyframe: la flecha rebota suavemente */
    @keyframes arrow-bounce {
        0%, 100% { transform: translateY(0); }
        45%       { transform: translateY(4px); }
    }

    /* Hover del botón primario */
    .btn-primary-cta:hover { opacity: 1; }

    .btn-primary-cta:hover span::after { width: 100%; }

    .btn-primary-cta:hover .arrow-circle {
        box-shadow: 0 6px 28px -4px rgba(168, 85, 247, 0.8);
    }

    .btn-primary-cta:hover .arrow-circle svg {
        animation: arrow-bounce 0.7s ease infinite;
    }

    /* ---- Botón SECUNDARIO: texto puro, sin caja ---- */
    .btn-outline-cta {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: rgba(255, 255, 255, 0.38);
        text-decoration: none;
        font-size: 0.88rem;
        font-weight: 500;
        letter-spacing: 0.2px;
        transition: color 0.3s ease;
    }

    .btn-outline-cta i {
        font-size: 0.68rem;
        transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1);
    }

    .btn-outline-cta:hover {
        color: rgba(255, 255, 255, 0.65);
    }

    .btn-outline-cta:hover i {
        transform: translateX(4px);
    }
    
    .scroll-down-btn:hover .arrow-wrapper svg {
        transform: translateY(3px); /* Pequeño rebote de la flecha */
    }

    /* --- MEDIA QUERIES --- */

    /* === LAPTOP PEQUEÑO (1025-1280px) === */
    @media (max-width: 1280px) {
        .mega-title { font-size: clamp(3rem, 6vw, 6rem); }
        .line.indent { margin-left: 3vw; }
    }

    @media (min-width: 1200px) {
        .line.indent { margin-left: 8vw; }
    }

    @media (max-width: 1024px) {
        .line.indent { margin-left: 0; }
        .mega-title { font-size: clamp(2.8rem, 6.5vw, 5.5rem); }
    }

    /* === MÓVIL (EL BOTÓN CHULO) === */
    @media (max-width: 768px) {
        .hero-section {
            padding-top: 90px;
            padding-bottom: 30px;
            align-items: flex-start; 
        }

        .fluid-height {
            justify-content: flex-start;
        }

        .mega-title {
            font-size: clamp(2.5rem, 13vw, 5.5rem);
            margin-bottom: 20px;
            white-space: normal;
            overflow: hidden;
            width: 100%;
            line-height: 0.95;
        }
        
        .line { 
            white-space: nowrap;
            overflow: hidden;
            padding: 2px 0;
        }
        
        .line.indent { margin-left: 0 !important; }

        .hero-desc { 
            font-size: 0.95rem;
            width: 100%;
            line-height: 1.6;
        }

        .label-wrapper {
            margin-bottom: 16px;
            font-size: 0.7rem;
            padding: 6px 12px;
        }

        /* Stats en móvil: apilados verticalmente de forma limpia y simétrica */
        .hero-stats {
            width: 100%;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            padding: 20px 15px;
            gap: 15px;
        }

        .stat-item { 
            width: 100%; 
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }
        
        .stat-num { font-size: 1.3rem; }
        .stat-label { font-size: 0.7rem; }

        /* Mostrar divisores sutiles en horizontal en lugar de vertical */
        .stat-divider { 
            width: 60px;
            height: 1px;
            background: rgba(255, 255, 255, 0.08);
        }

        /* CTAs: centrados y limpios en móvil */
        .hero-footer {
            flex-direction: column;
            align-items: center;
            gap: 16px;
            width: 100%;
            margin-top: 10px;
            padding-bottom: 20px;
        }

        .btn-primary-cta {
            width: 100%;
            justify-content: center;
            opacity: 1;
            font-size: 1rem;
            font-weight: 700;
        }

        .arrow-circle {
            width: 40px;
            height: 40px;
        }

        .btn-primary-cta:active .arrow-circle {
            transform: scale(0.93);
        }

        /* Secundario: centrado debajo */
        .btn-outline-cta {
            width: 100%;
            justify-content: center;
            color: rgba(255, 255, 255, 0.4);
            font-size: 0.85rem;
        }
    }
    
    @media (max-width: 380px) {
        .mega-title { font-size: clamp(2.2rem, 12.5vw, 4.5rem); }
        .label-wrapper { font-size: 0.65rem; }
    }
<style>
    /* CSS Original extraído de styles.css */
    .marquee-section { 
        padding: 80px 0; 
        border-top: 1px solid rgba(255,255,255,0.05); 
        border-bottom: 1px solid rgba(255,255,255,0.05); 
        overflow: hidden; 
        background: #080808; 
    }
    .marquee-inner { 
        display: flex; 
        width: fit-content; 
        animation: scrollMarquee 20s linear infinite; 
    }
    .marquee-part { 
        font-family: 'Syne', sans-serif; 
        font-size: 4rem; 
        font-weight: 700; 
        white-space: nowrap; 
        padding-right: 50px; 
        color: rgba(255,255,255,0.05); 
        transition: 0.3s; 
    }
    .marquee-section:hover .marquee-part { 
        color: var(--accent-color); 
        opacity: 0.5; 
    }
    
    @keyframes scrollMarquee { 
        0% { transform: translateX(0); } 
        100% { transform: translateX(-50%); } 
    }
</style>
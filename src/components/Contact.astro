---
// src/components/Contact.astro
const formAction = "https://formspree.io/f/xnnwwebz"; // Tu URL de Formspree
---

<section id="contact" class="contact-section">
    <div class="container">
        <div class="contact-wrapper">
            
            <div class="contact-info">
                <span class="subtitle">HABLEMOS DE NEGOCIOS</span>
                <h2 class="title">¿Listo para <br><span class="text-gradient">escalar?</span></h2>
                <p class="description">
                    Ya sea que necesites una web desde cero, una auditoría SEO o automatizar tus procesos. 
                    Estamos aquí para construir la solución exacta que necesitas.
                </p>

                <div class="direct-channels">
                    <a href="https://wa.me/34722625288" target="_blank" class="channel-card">
                        <div class="icon-box whatsapp">
                            <i class="fab fa-whatsapp"></i>
                        </div>
                        <div class="channel-details">
                            <span class="channel-label">Respuesta rápida</span>
                            <span class="channel-value">+34 722 625 288</span>
                        </div>
                        <i class="fas fa-arrow-right arrow-icon"></i>
                    </a>

                    <a href="mailto:ecentiaseo@gmail.com" class="channel-card">
                        <div class="icon-box email">
                            <i class="far fa-envelope"></i>
                        </div>
                        <div class="channel-details">
                            <span class="channel-label">Escríbenos</span>
                            <span class="channel-value">ecentiaseo@gmail.com</span>
                        </div>
                        <i class="fas fa-arrow-right arrow-icon"></i>
                    </a>
                </div>
            </div>

            <div class="contact-form-container">
                <form id="home-contact-form" action={formAction} method="POST" class="modern-form">
                    <div class="form-grid">
                        <div class="input-group">
                            <label for="nombre">Nombre</label>
                            <input type="text" id="nombre" name="nombre" placeholder="Tu nombre" required>
                        </div>
                        <div class="input-group">
                            <label for="empresa">Empresa</label>
                            <input type="text" id="empresa" name="empresa" placeholder="Nombre de tu negocio">
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="email">Email Corporativo</label>
                        <input type="email" id="email" name="email" placeholder="hola@tuempresa.com" required>
                    </div>

                    <div class="input-group">
                        <label>Me interesa...</label>
                        <div class="tags-container">
                            {['Diseño Web', 'E-Commerce', 'SEO', 'Automatización'].map(tag => (
                                <label class="tag-checkbox">
                                    <input type="checkbox" name="interes[]" value={tag}>
                                    <span class="tag-label">{tag}</span>
                                </label>
                            ))}
                        </div>
                    </div>

                    <div class="input-group">
                        <label for="mensaje">Detalles del proyecto</label>
                        <textarea id="mensaje" name="mensaje" rows="4" placeholder="Cuéntanos tus objetivos..." required></textarea>
                    </div>

                    <div class="form-footer">
                        <label class="privacy-check">
                            <input type="checkbox" required>
                            <span>Acepto la <a href="/legal/politica-privacidad">política de privacidad</a></span>
                        </label>
                        
                        <button type="submit" id="submit-btn" class="submit-btn">
                            <span>Enviar Propuesta</span>
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>

<style>
    .contact-section {
        padding: 140px 0;
        background: #050510; /* Color de fondo oscuro sólido para contraste */
        position: relative;
    }

    .contact-wrapper {
        display: grid;
        grid-template-columns: 1fr 1.2fr;
        gap: 80px;
        align-items: start;
    }

    /* Columna Izquierda */
    .subtitle {
        font-family: 'Syne', sans-serif;
        font-size: 0.9rem;
        letter-spacing: 3px;
        color: var(--accent-color);
        text-transform: uppercase;
        margin-bottom: 20px;
        display: block;
        font-weight: 700;
    }

    .title {
        font-family: 'Syne', sans-serif;
        font-size: clamp(3rem, 5vw, 4.5rem);
        line-height: 1.1;
        margin-bottom: 30px;
        font-weight: 700;
        color: var(--white);
    }

    .text-gradient {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .description {
        font-size: 1.1rem;
        line-height: 1.7;
        color: var(--text-muted);
        margin-bottom: 50px;
        max-width: 90%;
    }

    .direct-channels {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .channel-card {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 20px;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: 15px;
        text-decoration: none;
        transition: all 0.3s ease;
    }

    .channel-card:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.1);
        transform: translateX(10px);
    }

    .icon-box {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .icon-box.whatsapp { background: rgba(37, 211, 102, 0.1); color: #25D366; }
    .icon-box.email { background: rgba(168, 85, 247, 0.1); color: #a855f7; }

    .channel-details {
        display: flex;
        flex-direction: column;
        flex: 1;
    }

    .channel-label { font-size: 0.8rem; color: var(--gray); text-transform: uppercase; letter-spacing: 1px; }
    .channel-value { font-size: 1.1rem; color: var(--white); font-weight: 600; font-family: 'Syne', sans-serif; }

    .arrow-icon { color: var(--gray); transition: transform 0.3s ease; }
    .channel-card:hover .arrow-icon { color: var(--white); transform: translateX(5px); }

    /* Columna Derecha (Formulario) */
    .contact-form-container {
        background: rgba(255, 255, 255, 0.02);
        padding: 50px;
        border-radius: 24px;
        border: 1px solid rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(10px);
    }

    .modern-form { display: flex; flex-direction: column; gap: 25px; }
    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; }

    .input-group { display: flex; flex-direction: column; gap: 10px; }
    
    .input-group label {
        font-size: 0.9rem;
        color: var(--gray);
        font-weight: 500;
    }

    .input-group input, 
    .input-group textarea {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 15px;
        color: var(--white);
        font-size: 1rem;
        font-family: 'Inter', sans-serif;
        transition: all 0.3s ease;
        outline: none;
    }

    .input-group input:focus, 
    .input-group textarea:focus {
        border-color: var(--accent-color);
        background: rgba(168, 85, 247, 0.05);
        box-shadow: 0 0 0 4px rgba(168, 85, 247, 0.1);
    }

    /* Tags */
    .tags-container { display: flex; flex-wrap: wrap; gap: 10px; }
    .tag-checkbox input { display: none; }
    .tag-label {
        display: inline-block;
        padding: 8px 16px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 50px;
        color: var(--text-muted);
        font-size: 0.9rem;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    .tag-checkbox input:checked + .tag-label {
        background: var(--accent-color);
        color: var(--white);
        border-color: var(--accent-color);
    }

    /* Footer Form */
    .form-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 20px;
    }

    .privacy-check {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.85rem;
        color: var(--gray);
        cursor: pointer;
    }
    .privacy-check a { color: var(--white); text-decoration: underline; }

    .submit-btn {
        padding: 16px 35px;
        background: var(--white);
        color: var(--bg-color);
        border: none;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 10px;
        transition: all 0.3s ease;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(255, 255, 255, 0.15);
    }

    /* Botones de estado (JS) */
    .btn-success { background: #10B981 !important; color: white !important; }
    .btn-error { background: #EF4444 !important; color: white !important; }

    @media (max-width: 992px) {
        .contact-wrapper { grid-template-columns: 1fr; gap: 50px; }
        .contact-form-container { padding: 30px; }
        .form-footer { flex-direction: column; gap: 20px; align-items: stretch; }
        .submit-btn { justify-content: center; }
    }
    
    @media (max-width: 600px) {
        .form-grid { grid-template-columns: 1fr; }
    }
</style>

<script>
    // Lógica de envío del formulario
    document.addEventListener('astro:page-load', () => {
        const form = document.getElementById('home-contact-form') as HTMLFormElement;
        const btn = document.getElementById('submit-btn') as HTMLButtonElement;

        if (form && btn) {
            const originalText = btn.innerHTML;

            form.addEventListener('submit', async (e) => {
                e.preventDefault();
                const formData = new FormData(form);

                // Estado Cargando
                btn.innerHTML = 'Enviando... <i class="fas fa-spinner fa-spin"></i>';
                btn.style.opacity = '0.7';
                btn.disabled = true;

                try {
                    const response = await fetch(form.action, {
                        method: 'POST',
                        body: formData,
                        headers: { 'Accept': 'application/json' }
                    });

                    if (response.ok) {
                        btn.innerHTML = '¡Enviado! <i class="fas fa-check"></i>';
                        btn.classList.add('btn-success');
                        form.reset();
                    } else {
                        throw new Error('Error en el envío');
                    }
                } catch (error) {
                    btn.innerHTML = 'Error al enviar <i class="fas fa-times"></i>';
                    btn.classList.add('btn-error');
                } finally {
                    setTimeout(() => {
                        btn.innerHTML = originalText;
                        btn.classList.remove('btn-success', 'btn-error');
                        btn.style.opacity = '1';
                        btn.disabled = false;
                    }, 4000);
                }
            });
        }
    });
</script>
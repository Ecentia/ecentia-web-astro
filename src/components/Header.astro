---
// src/components/Header.astro
const pathname = new URL(Astro.request.url).pathname;
// Normalizamos para evitar problemas con barras finales (ej: /contacto vs /contacto/)
const currentPath = pathname === '/' ? '/' : pathname.replace(/\/$/, "");

const isActive = (path: string) => {
  if (path === '/') return currentPath === '/';
  return currentPath.startsWith(path);
};
---

<nav class="nav-floating" id="main-nav">
  <div class="nav-content">
    <a href="/" class="branding magnet-target">
      <span class="logo-text"
        >Ecentia<span style="color: var(--accent-color);">.</span></span
      >
    </a>

    <div class="nav-items">
      <a href="/" class="magnet-target">Inicio</a>
      <a href="/proyectos" class="magnet-target">Proyectos</a>
      <a href="/servicios" class="magnet-target">Servicios</a>
      <a href="/blog" class="magnet-target">Blog</a>
      <a href="/contacto" class="btn-contact magnet-target">Contacto</a>
    </div>

    <button class="menu-toggle" aria-label="Abrir menú" id="menu-btn">
      <span class="hamburger-line top"></span>
      <span class="hamburger-line bottom"></span>
    </button>
  </div>
</nav>

<div class="mobile-menu-overlay" id="mobile-menu">
  <div class="mobile-links">
    <a 
      href="/" 
      class:list={["mobile-link", { "highlight": isActive('/') }]}
    >
      Inicio
    </a>
    <a 
      href="/proyectos" 
      class:list={["mobile-link", { "highlight": isActive('/proyectos') }]}
    >
      Proyectos
    </a>
    <a 
      href="/servicios" 
      class:list={["mobile-link", { "highlight": isActive('/servicios') }]}
    >
      Servicios
    </a>
    <a 
      href="/blog" 
      class:list={["mobile-link", { "highlight": isActive('/blog') }]}
    >
      Blog
    </a>
    <a 
      href="/contacto" 
      class:list={["mobile-link", { "highlight": isActive('/contacto') }]}
    >
      Contacto
    </a>
  </div>
</div>

<script>
  document.addEventListener("astro:page-load", () => {
    const menuBtn = document.getElementById("menu-btn");
    const mobileMenu = document.getElementById("mobile-menu");
    const mobileLinks = document.querySelectorAll(".mobile-link");
    const nav = document.getElementById("main-nav");

    if (!menuBtn || !mobileMenu) return;

    // Función para cerrar menú
    const closeMenu = () => {
      menuBtn.classList.remove("active");
      mobileMenu.classList.remove("active");
      document.body.classList.remove("menu-open");
      nav?.classList.remove("nav-open");
    };

    menuBtn.addEventListener("click", () => {
      const isActive = menuBtn.classList.contains("active");
      
      if (isActive) {
        closeMenu();
      } else {
        menuBtn.classList.add("active");
        mobileMenu.classList.add("active");
        document.body.classList.add("menu-open");
        nav?.classList.add("nav-open");
      }
    });

    mobileLinks.forEach((link) => {
      link.addEventListener("click", () => {
        closeMenu();
      });
    });
  });
</script>

<style>
  /* --- ESTILOS DE ESCRITORIO --- */
  .nav-floating {
    position: fixed;
    top: 30px;
    left: 50%;
    transform: translateX(-50%);
    width: 90%;
    max-width: var(--container-width);
    z-index: 100;
    mix-blend-mode: difference;
    transition: top 0.3s ease;
  }

  .nav-floating.nav-open {
    mix-blend-mode: normal;
    z-index: 1001;
  }

  .nav-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 100%;
  }

  .branding {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
  }

  .logo-text {
    font-family: "Syne", sans-serif;
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--white);
  }

  .nav-items {
    display: flex;
    gap: 30px;
    align-items: center;
  }

  .nav-items a {
    text-decoration: none;
    color: var(--white);
    font-weight: 500;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    position: relative;
  }

  .nav-items a::after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--white);
    transition: 0.3s;
  }

  .nav-items a:hover::after {
    width: 100%;
  }

  /* --- OCULTAR ELEMENTOS MÓVILES EN ESCRITORIO --- */
  .menu-toggle {
    display: none;
  }
  .mobile-menu-overlay {
    display: none;
  }

  /* --- ESTILOS MÓVILES --- */
  @media (max-width: 768px) {
    .nav-floating {
      width: 92%;
      padding: 10px 0;
      top: 15px;
      mix-blend-mode: normal;
    }

    .nav-content {
      padding: 0 15px;
      min-height: 40px;
    }

    /* Ocultar menú de escritorio */
    .nav-items {
      display: none;
    }

    /* Mostrar botón móvil */
    .menu-toggle {
      display: flex;
      background: none;
      border: none;
      cursor: pointer;
      width: 30px;
      height: 30px;
      flex-direction: column;
      justify-content: center;
      align-items: flex-end;
      gap: 6px;
      padding: 0;
      z-index: 1002;
      position: relative;
    }

    .hamburger-line {
      display: block;
      height: 2px;
      background-color: var(--white);
      transition: all 0.3s ease;
    }

    .hamburger-line.top {
      width: 28px;
    }
    .hamburger-line.bottom {
      width: 18px;
    }

    .menu-toggle.active .hamburger-line {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 28px;
      margin: 0;
    }

    .menu-toggle.active .hamburger-line.top {
      transform: translate(-50%, -50%) rotate(45deg);
    }

    .menu-toggle.active .hamburger-line.bottom {
      transform: translate(-50%, -50%) rotate(-45deg);
    }

    /* Overlay */
    .mobile-menu-overlay {
      display: flex;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100vh;
      background-color: #050510;
      z-index: 999;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.4s ease;
    }

    .mobile-menu-overlay.active {
      opacity: 1;
      visibility: visible;
      pointer-events: all;
    }

    .mobile-links {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 2rem;
    }

    .mobile-link {
      font-family: "Syne", sans-serif;
      font-size: 2rem;
      font-weight: 700;
      color: var(--white);
      text-decoration: none;
      text-transform: uppercase;
    }

    .mobile-link.highlight {
      color: var(--accent-color);
    }
  }
</style>
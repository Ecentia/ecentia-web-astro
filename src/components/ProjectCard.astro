---
// src/components/ProjectCard.astro
interface Props {
    title: string;
    category: string;
    description: string;
    tags: string[];
    image: string;
    link?: string;
    reverse?: boolean;
}

const { title, category, description, tags, image, link = "#", reverse = false } = Astro.props;
---

<div class={`project-item ${reverse ? 'reverse' : ''}`}>
    <div class="project-info">
        <span class="cat">{category}</span>
        <h3>{title}</h3>
        <p>{description}</p>
        <ul class="tags">
            {tags.map((tag) => <li>{tag}</li>)}
        </ul>
    </div>
    
    <div class="project-visual magnet-target">
        <div class="visual-inner" style={`background: url('${image}') center/contain no-repeat;`}>
            <a href={link} target="_blank" class="overlay-reveal">Ir a la web</a>
        </div>
    </div>
</div>

<style>
    /* CSS Original para los items de proyecto */
    .project-item { display: flex; gap: 60px; align-items: center; margin-bottom: 150px; }
    /* Ajuste para el último item si quieres que no tenga margen */
    .project-item:last-child { margin-bottom: 0; }
    
    .project-item.reverse { flex-direction: row-reverse; }

    .project-info { flex: 1; }
    .cat { color: var(--accent-color); font-weight: 600; text-transform: uppercase; letter-spacing: 2px; font-size: 0.8rem; margin-bottom: 15px; display: block; }
    .project-info h3 { font-family: 'Syne', sans-serif; font-size: 3.5rem; margin-bottom: 20px; line-height: 1; }
    .project-info p { color: var(--gray); font-size: 1.1rem; margin-bottom: 30px; max-width: 400px; }
    
    .tags { display: flex; gap: 10px; list-style: none; }
    .tags li { border: 1px solid rgba(255,255,255,0.1); padding: 5px 15px; border-radius: 20px; font-size: 0.8rem; color: var(--text-color); }

    .project-visual { flex: 1.5; height: 500px; position: relative; border-radius: 10px; overflow: hidden; transform-origin: center; transition: transform 0.5s; }
    .visual-inner { 
        width: 100%; height: 100%; transition: transform 0.6s; display: flex; align-items: center; justify-content: center; 
        background-color: #1a1a1a; 
    }
    .project-visual:hover { transform: scale(0.98); }
    .project-visual:hover .visual-inner { transform: scale(1.1); }

    .overlay-reveal { 
        opacity: 0; 
        font-family: 'Syne', sans-serif; font-weight: 700; font-size: 1rem; 
        color: #000000; background: #ffffff; padding: 15px 30px; border-radius: 4px;     
        box-shadow: 0 10px 25px rgba(0,0,0,0.5); transition: 0.3s; z-index: 2; 
        text-transform: uppercase; letter-spacing: 1px; transform: translateY(20px); 
        text-decoration: none; display: inline-block; 
    }
    .project-visual:hover .overlay-reveal { opacity: 1; transform: translateY(0); }

    /* Media Queries */
    @media (max-width: 768px) {
        .project-item, .project-item.reverse { flex-direction: column-reverse; gap: 30px; }
        .project-visual { width: 100%; height: 300px; }
        .project-info { text-align: left; padding: 0 10px; }
        .project-info h3 { font-size: 2.2rem; }
    }
</style>
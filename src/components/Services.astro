---
// src/components/Services.astro
const services = [
    {
        num: "01",
        title: "Diseño Web Premium",
        subtitle: "Experiencias que venden por sí solas.",
        desc: "Rompemos el molde de lo convencional. No usamos plantillas prefabricadas; diseñamos arquitecturas digitales a medida centradas en la conversión. Fusionamos estética de vanguardia con psicología de usuario para que tu web no solo sea bonita, sino una máquina de ventas.",
        tags: ["UI/UX Design", "Figma Prototyping", "Animaciones WebGL", "Desarrollo a Medida"],
        icon: "fa-plus"
    },
    {
        num: "02",
        title: "Automatización & IA",
        subtitle: "Tu negocio trabajando en piloto automático.",
        desc: "El tiempo es tu activo más valioso. Implementamos ecosistemas de Inteligencia Artificial y automatizaciones (Zapier/Make) que eliminan tareas repetitivas. Desde chatbots que cierran ventas hasta sistemas de facturación automática. Escala sin aumentar personal.",
        tags: ["Chatbots IA", "Integraciones API", "CRM Automations", "Lead Scoring"],
        icon: "fa-plus"
    },
    {
        num: "03",
        title: "E-Commerce Avanzado",
        subtitle: "Tiendas rápidas, seguras y rentables.",
        desc: "Desarrollamos plataformas de comercio electrónico robustas preparadas para altos volúmenes de tráfico. Optimizamos cada paso del checkout para reducir carritos abandonados e implementamos estrategias de venta cruzada (Upselling) inteligentes.",
        tags: ["Shopify & WooCommerce", "Pasarelas de Pago", "Gestión de Stock", "CRO"],
        icon: "fa-plus"
    },
    {
        num: "04",
        title: "SEO & Growth",
        subtitle: "Domina los resultados de búsqueda.",
        desc: "Tener la mejor web del mundo no sirve de nada si es invisible. Trazamos estrategias de posicionamiento agresivas (SEO On-Page, Técnico y Linkbuilding) para colocarte por delante de tu competencia en las palabras clave que realmente generan facturación.",
        tags: ["Auditoría Técnica", "Estrategia de Contenidos", "SEO Local", "Analítica Avanzada"],
        icon: "fa-plus"
    }
];
---

<section id="services-list" class="services-list-section">
    <div class="container">
        <div class="accordion-wrapper">
            {services.map((service, index) => (
                <div class="service-item" tabindex="0">
                    <div class="service-header">
                        <div class="header-left">
                            <span class="service-number">/{service.num}</span>
                            <h3 class="service-title">{service.title}</h3>
                        </div>
                        <div class="icon-wrapper">
                            <i class="fas fa-plus toggle-icon"></i>
                        </div>
                    </div>

                    <div class="service-body">
                        <div class="body-inner">
                            <h4 class="service-subtitle">{service.subtitle}</h4>
                            <div class="content-grid">
                                <p class="service-desc">{service.desc}</p>
                                <div class="tags-container">
                                    <span class="tags-label">Tecnologías:</span>
                                    <ul class="tags-list">
                                        {service.tags.map(tag => (
                                            <li>{tag}</li>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="separator"></div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
    .services-list-section {
        padding: 100px 0;
        position: relative;
        z-index: 10;
    }

    .accordion-wrapper {
        display: flex;
        flex-direction: column;
    }

    .service-item {
        position: relative;
        cursor: pointer;
        padding: 40px 0;
    }

    /* CABECERA */
    .service-header {
        display: flex;
        justify-content: space-between;
        align-items: center; 
        gap: 20px;
    }

    .header-left {
        display: flex;
        align-items: baseline;
        gap: 40px;
        flex: 1;
    }

    .service-number {
        font-family: 'Syne', sans-serif;
        font-size: 1.2rem;
        color: var(--accent-color);
        opacity: 0.8;
        font-weight: 600;
        flex-shrink: 0;
    }

    .service-title {
        font-family: 'Syne', sans-serif;
        font-size: clamp(1.8rem, 5vw, 4rem); 
        font-weight: 700;
        color: var(--text-muted);
        transition: color 0.4s ease, transform 0.4s ease;
        margin: 0;
        line-height: 1.1;
    }

    @media (hover: hover) {
        .service-item:hover .service-title {
            color: var(--white);
            transform: translateX(20px);
        }
    }

    /* --- ICONO LIMPIO (SIN FONDO ROSA) --- */
    .icon-wrapper {
        width: 50px;
        height: 50px;
        min-width: 50px; 
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid rgba(255, 255, 255, 0.2); /* Borde sutil */
        border-radius: 50%; /* Mantenemos redondo pero hueco */
        transition: all 0.4s ease;
        background: transparent; /* Transparente siempre */
    }

    .toggle-icon {
        font-size: 1.2rem;
        color: var(--white);
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275); /* Efecto rebote suave */
    }

    /* --- ESTADO ACTIVO --- */
    .service-item.active .service-title {
        color: var(--white);
    }

    .service-item.active .icon-wrapper {
        border-color: var(--white); /* Se vuelve blanco puro */
        /* ELIMINADO: background: var(--accent-color); */
    }

    .service-item.active .toggle-icon {
        /* Rota 45 grados: El + se convierte en una X perfecta */
        transform: rotate(135deg); 
        color: var(--white);
    }

    /* CUERPO DESPLEGABLE */
    .service-body {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s ease;
        opacity: 0.5;
        will-change: max-height;
    }

    .service-item.active .service-body {
        max-height: 800px; 
        opacity: 1;
    }

    .body-inner {
        padding: 40px 0 20px 80px; 
    }

    .service-subtitle {
        font-family: 'Syne', sans-serif;
        font-size: 1.5rem;
        color: var(--white);
        margin-bottom: 20px;
        font-weight: 600;
        line-height: 1.3;
    }

    .content-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 60px;
    }

    .service-desc {
        font-size: 1.1rem;
        line-height: 1.7;
        color: var(--text-muted);
    }

    /* TAGS */
    .tags-container {
        border-left: 1px solid rgba(255, 255, 255, 0.1);
        padding-left: 30px;
    }

    .tags-label {
        display: block;
        font-size: 0.9rem;
        color: var(--accent-color);
        margin-bottom: 15px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .tags-list {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .tags-list li {
        font-family: 'Syne', sans-serif;
        color: var(--white);
        font-size: 1.1rem;
        position: relative;
        padding-left: 15px;
    }

    .tags-list li::before {
        content: '•';
        position: absolute;
        left: 0;
        color: var(--accent-color);
    }

    /* SEPARADOR */
    .separator {
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 1px;
        background: rgba(255, 255, 255, 0.1);
        transition: all 0.4s ease;
    }

    .service-item:hover .separator {
        background: rgba(255, 255, 255, 0.3);
    }

    .service-item.active .separator {
        background: var(--accent-color);
        box-shadow: 0 0 10px var(--accent-color);
    }

    /* --- RESPONSIVE --- */
    @media (max-width: 992px) {
        .header-left { gap: 20px; }
        .body-inner { padding-left: 0; padding-top: 30px; }
        .content-grid { grid-template-columns: 1fr; gap: 30px; }
        .tags-container { border-left: none; padding-left: 0; border-top: 1px solid rgba(255,255,255,0.1); padding-top: 20px; }
        .tags-list { flex-direction: row; flex-wrap: wrap; gap: 15px; }
    }

    @media (max-width: 768px) {
        .services-list-section { padding: 60px 0; }
        .service-item { padding: 30px 0; }
        .service-header { align-items: flex-start; }
        .header-left { flex-direction: column; gap: 10px; }
        .service-number { display: none; }
        
        .service-title { 
            font-size: 1.8rem; 
            line-height: 1.2;
            padding-right: 10px; 
        }

        /* Icono en móvil */
        .icon-wrapper {
            width: 40px;
            height: 40px;
            min-width: 40px;
            margin-top: 0;
            border-color: rgba(255,255,255,0.1); /* Más sutil en móvil */
        }

        .service-subtitle { font-size: 1.3rem; }
        .service-item.active .service-title { color: var(--white); }
    }
</style>

<script>
    document.addEventListener('astro:page-load', () => {
        const items = document.querySelectorAll('.service-item');
        items.forEach(item => {
            item.addEventListener('click', (e) => {
                e.preventDefault();
                const isActive = item.classList.contains('active');
                items.forEach(i => { if (i !== item) i.classList.remove('active'); });
                item.classList.toggle('active', !isActive);
            });
        });
    });
</script>
---
// src/components/HomeServices.astro
const tags = [
    "Estrategia Digital", "UX/UI Design", "Desarrollo Web", 
    "Astro & React", "SEO Avanzado", "E-Commerce", 
    "Automatización IA", "Branding"
];
---

<section class="home-services-section">
    <div class="container">
        <div class="services-wrapper">
            
            <div class="content-col">
                <div class="label-box">
                    <span class="pulse-icon"></span>
                    <span class="label-text">ECOSISTEMA DIGITAL</span>
                </div>
                
                <h2 class="title">Todo lo que necesitas para <span class="text-highlight">liderar tu sector.</span></h2>
                
                <p class="description">
                    No somos una agencia de "hacer webs", somos tu departamento de innovación externa. 
                    Centralizamos diseño, tecnología y estrategia para que no tengas que gestionar cinco proveedores distintos.
                </p>

                <a href="/servicios" class="btn-tech">
                    <span class="btn-text">Explorar el Ecosistema</span>
                    <i class="fas fa-arrow-right"></i>
                    <div class="btn-glow"></div>
                </a>
            </div>

            <div class="energy-connector">
                <div class="energy-line"></div>
                <div class="energy-point"></div>
            </div>

            <div class="visual-col">
                <div class="tags-cloud-container">
                    <div class="tags-cloud">
                        {tags.map((tag, index) => (
                            <div class="tech-tag" style={`--delay: ${index * 0.1}s`}>
                                <span class="hash">#</span>{tag}
                            </div>
                        ))}
                    </div>
                    <div class="network-bg"></div>
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    /* --- ESTILOS BASE (Desktop) --- */
    .home-services-section {
        padding: 140px 0;
        position: relative;
        overflow: hidden;
        background: linear-gradient(180deg, var(--bg-color) 0%, #080810 100%);
        border-top: 1px solid rgba(255, 255, 255, 0.05);
    }

    .services-wrapper {
        display: grid;
        grid-template-columns: 1fr auto 0.8fr; /* 3 columnas: Texto | Conector | Tags */
        gap: 40px;
        align-items: center;
    }

    /* COLUMNA IZQUIERDA */
    .content-col { position: relative; z-index: 2; }
    .label-box { display: inline-flex; align-items: center; gap: 10px; margin-bottom: 25px; padding: 8px 16px; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 100px; }
    .pulse-icon { width: 8px; height: 8px; background: var(--accent-color); border-radius: 50%; box-shadow: 0 0 10px var(--accent-color); animation: pulse 2s infinite; }
    .label-text { font-family: 'Syne', sans-serif; font-size: 0.8rem; color: var(--white); letter-spacing: 1px; text-transform: uppercase; font-weight: 600; }
    .title { font-family: 'Syne', sans-serif; font-size: clamp(2.5rem, 4vw, 3.5rem); line-height: 1.15; color: var(--white); margin-bottom: 30px; font-weight: 700; }
    .text-highlight { color: var(--accent-color); }
    .description { font-size: 1.15rem; line-height: 1.7; color: var(--text-muted); margin-bottom: 40px; max-width: 90%; }
    
    .btn-tech { position: relative; display: inline-flex; align-items: center; gap: 15px; padding: 18px 40px; background: transparent; border: 1px solid rgba(255, 255, 255, 0.2); color: var(--white); text-decoration: none; font-family: 'Syne', sans-serif; font-weight: 600; border-radius: 4px; overflow: hidden; transition: all 0.3s ease; }
    .btn-tech:hover { border-color: var(--accent-color); transform: translateX(5px); box-shadow: -5px 0 20px rgba(168, 85, 247, 0.2); }
    .btn-glow { position: absolute; top: 0; left: -100%; width: 100%; height: 100%; background: linear-gradient(90deg, transparent, rgba(168, 85, 247, 0.3), transparent); transition: 0.6s; }
    .btn-tech:hover .btn-glow { left: 100%; }

    /* CONECTOR CENTRAL */
    .energy-connector {
        position: relative;
        height: 200px;
        display: flex;
        align-items: center;
    }

    .energy-line {
        width: 100px;
        height: 2px;
        background: linear-gradient(90deg, var(--accent-color), transparent);
        opacity: 0.5;
    }

    .energy-point {
        position: absolute;
        left: 0;
        width: 10px;
        height: 10px;
        background: var(--accent-color);
        border-radius: 50%;
        box-shadow: 0 0 15px var(--accent-color), 0 0 30px var(--accent-color);
        animation: flowRight 3s infinite linear;
    }

    /* COLUMNA DERECHA (Visual) */
    .visual-col { position: relative; display: flex; justify-content: center; align-items: center; }
    
    .tags-cloud-container {
        position: relative;
        padding: 40px;
        border-radius: 20px;
        background: rgba(20, 20, 30, 0.3);
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .tags-cloud { display: flex; flex-wrap: wrap; gap: 15px; justify-content: flex-end; position: relative; z-index: 2; }
    .tech-tag { padding: 10px 20px; background: rgba(10, 10, 15, 0.8); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 6px; color: var(--gray); font-family: 'Inter', sans-serif; font-size: 0.9rem; backdrop-filter: blur(5px); transition: all 0.3s ease; cursor: default; display: flex; align-items: center; gap: 5px; }
    .hash { color: var(--accent-color); opacity: 0.7; }
    .tech-tag:hover { border-color: var(--accent-color); color: var(--white); transform: translateY(-3px) scale(1.05); box-shadow: 0 5px 15px rgba(168, 85, 247, 0.15); }

    .network-bg {
        position: absolute;
        top: 50%; left: 50%; transform: translate(-50%, -50%);
        width: 120%; height: 120%;
        background-image: radial-gradient(circle, rgba(168, 85, 247, 0.1) 1px, transparent 1px);
        background-size: 20px 20px;
        opacity: 0.5;
        z-index: 0;
        pointer-events: none;
        mask-image: radial-gradient(circle, black 30%, transparent 80%);
    }

    @keyframes pulse { 0% { box-shadow: 0 0 0 0 rgba(168, 85, 247, 0.4); } 70% { box-shadow: 0 0 0 10px rgba(168, 85, 247, 0); } 100% { box-shadow: 0 0 0 0 rgba(168, 85, 247, 0); } }
    @keyframes flowRight { 0% { left: 0; opacity: 0; } 10% { opacity: 1; } 90% { opacity: 1; } 100% { left: 100px; opacity: 0; } }

    /* --- RESPONSIVE OPTIMIZADO (AQUÍ ESTÁ LA MEJORA) --- */
    @media (max-width: 992px) {
        .home-services-section {
            padding: 80px 0; /* Padding más cómodo para móvil */
        }

        .services-wrapper {
            grid-template-columns: 1fr;
            gap: 40px;
            /* Alineamos todo al centro para mayor impacto visual */
            text-align: center;
        }

        .content-col {
            display: flex; 
            flex-direction: column; 
            align-items: center; 
        }

        .description {
            max-width: 100%; /* Aprovecha el ancho */
            margin-left: auto; margin-right: auto;
            font-size: 1rem;
        }
        
        .energy-connector { display: none; }

        /* MEJORA VISUAL: Contenedor destacado en móvil */
        .tags-cloud-container { 
            padding: 30px 20px; 
            /* Fondo oscuro para contraste */
            background: rgba(15, 15, 25, 0.6); 
            /* Borde brillante sutil */
            border: 1px solid rgba(168, 85, 247, 0.2); 
            /* Sombra para dar profundidad */
            box-shadow: 0 10px 30px -10px rgba(168, 85, 247, 0.15);
            width: 100%;
        }

        .tags-cloud { 
            justify-content: center; /* Tags centrados */
            gap: 12px;
        }

        .tech-tag {
            font-size: 0.85rem;
            padding: 8px 14px;
        }
        
        /* BOTÓN MÁS LLAMATIVO */
        .btn-tech {
            width: 100%; /* Botón ancho para dedo fácil */
            max-width: 320px; /* Pero con límite */
            justify-content: center;
            background: rgba(168, 85, 247, 0.05); /* Tinte púrpura muy suave */
            border-color: rgba(168, 85, 247, 0.4);
        }
    }
</style>
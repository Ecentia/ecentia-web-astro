---
import '../styles/global.css';
import { ViewTransitions } from 'astro:transitions';
import { seoConfig, type PageKey } from '../data/seo';

interface Props {
    title?: string;
    description?: string;
    keywords?: string;
    image?: string;
    pageKey?: PageKey;
    bodyClass?: string;
    showLoader?: boolean;
    noindex?: boolean;
}

const { 
    title, 
    description, 
    keywords,
    image,
    pageKey,
    bodyClass = "", 
    showLoader = true,
    noindex = false 
} = Astro.props;

// ✅ Acceso tipado correctamente
const currentPage = pageKey ? seoConfig.pages[pageKey as PageKey] : null;

const seoTitle = title || currentPage?.title || seoConfig.defaultTitle;
const seoDescription = description || currentPage?.description || seoConfig.defaultDescription;
const seoKeywords = keywords || currentPage?.keywords || seoConfig.keywords.join(', ');
const seoImage = image || `${seoConfig.siteUrl}${seoConfig.defaultImage}`;
const canonicalURL = new URL(Astro.url.pathname, seoConfig.siteUrl).href;

// ---------------- JSON-LD ----------------
const baseSchema = {
  "@type": "ProfessionalService",
  "name": seoConfig.siteName,
  "url": seoConfig.siteUrl,
  "logo": {
    "@type": "ImageObject",
    "url": `${seoConfig.siteUrl}/logo.avif`,
    "width": 512,
    "height": 512
  },
  "image": seoImage,
  "description": seoDescription,
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Sevilla",
    "addressRegion": "Andalucía",
    "addressCountry": "ES"
  },
  "sameAs": [
    "https://www.instagram.com/ecentiamarketing/",
    "https://www.linkedin.com/company/ecentia-marketing/"
  ],
  "priceRange": "$$",
  "telephone": "+34722625288",
  "email": "ecentiaseo@gmail.com"
};

const jsonLd = {
  "@context": "https://schema.org",
  ...(currentPage?.schema ?? {}),
  ...baseSchema
};
---

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    
    <title>{seoTitle}</title>
    <meta name="description" content={seoDescription} />
    <meta name="keywords" content={seoKeywords} />
    <link rel="canonical" href={canonicalURL} />

    {noindex ? (
        <meta name="robots" content="noindex, nofollow" />
    ) : (
        <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <meta property="og:title" content={seoTitle} />
    <meta property="og:description" content={seoDescription} />
    <meta property="og:image" content={seoImage} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={seoConfig.siteName} />
    <meta property="og:type" content={pageKey === 'home' ? 'website' : 'article'} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seoTitle} />
    <meta name="twitter:description" content={seoDescription} />
    <meta name="twitter:image" content={seoImage} />

    <link rel="icon" href="/favicon.ico" />
    <meta name="theme-color" content="#050510" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=Syne:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <script is:inline>
    (function(w,d,s,l,i){
      // @ts-ignore
      w[l]=w[l]||[];
      // @ts-ignore
      w[l].push({'gtm.start': new Date().getTime(), event:'gtm.js'});
      var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l='+l : '';
      // @ts-ignore
      j.async = true;
      // @ts-ignore
      j.src = 'https://www.googletagmanager.com/gtm.js?id='+i+dl;
      f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','G-FKEZKR17FN');
    </script>

    <ViewTransitions />
</head>

<body class={`${showLoader ? 'loading' : ''} ${bodyClass}`}>

    <noscript>
      <iframe src="https://www.googletagmanager.com/ns.html?id=G-FKEZKR17FN"
      height="0" width="0" style="display:none;visibility:hidden"></iframe>
    </noscript>

    {showLoader && (
        <div class="preloader">
            <div class="loader-text">ECENTIA</div>
            <div class="loader-bar">
                <div class="bar-fill"></div>
            </div>
        </div>
    )}

    <div class="noise-overlay"></div>
    <canvas id="cursor-canvas"></canvas>
    <div id="main-cursor"></div>

    <main id="main-content">
        <slot />
    </main>

    <script>
    document.addEventListener('astro:page-load', () => {
        const body = document.body;
        const preloader = document.querySelector('.preloader') as HTMLElement | null;
        const barFill = document.querySelector('.bar-fill') as HTMLElement | null;

        const hasVisited = sessionStorage.getItem('visited');

        if (hasVisited) {
            if (preloader) preloader.style.display = 'none';
            body.classList.add('loaded');
            body.classList.remove('loading');
        } else {
            sessionStorage.setItem('visited', 'true');
            if (barFill && body.classList.contains('loading')) {
                let width = 0;
                const interval = setInterval(() => {
                    width += Math.random() * 20;
                    if (width > 100) width = 100;
                    barFill.style.width = width + '%';

                    if (width === 100) {
                        clearInterval(interval);
                        setTimeout(() => {
                            body.classList.add('loaded');
                            body.classList.remove('loading');
                        }, 300);
                    }
                }, 50);
            }

            // Fallback de seguridad
            setTimeout(() => {
                if (body.classList.contains('loading')) {
                    body.classList.add('loaded');
                    body.classList.remove('loading');
                }
            }, 2500);
        }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    const target = entry.target as HTMLElement;
                    target.style.opacity = '1';
                    target.style.transform = 'translateY(0)';
                    observer.unobserve(target);
                }
            });
        }, { threshold: 0.1 });

        const animatedElements = document.querySelectorAll(
            '.fade-in-up, .project-item, .hero-footer, .legal-header, .legal-main, .page-header-content'
        );
        animatedElements.forEach(el => observer.observe(el));
    });
    </script>

    <script src="../scripts/cursor.js"></script>
</body>
</html>

<style is:global>
    /* Estilos Críticos de Layout */
    html {
        -webkit-text-size-adjust: 100%; /* Evita cambio de tamaño de fuente al girar móvil */
    }

    /* Corrección del Preloader: 
       Usamos fixed para asegurar que cubra todo, pero evitamos bugs de scroll */
    html body.loading {
        overflow: hidden !important;
        height: 100dvh !important; /* Usar dvh para móviles */
        width: 100% !important;
        position: fixed; /* Mantiene la pantalla quieta mientras carga */
    }

    /* Scroll suave nativo para iOS */
    #main-content {
        -webkit-overflow-scrolling: touch;
        width: 100%;
        overflow-x: hidden; /* Doble seguridad */
    }
</style>
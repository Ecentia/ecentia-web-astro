---
// src/pages/proyectos.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Footer from "../components/Footer.astro";
import { link } from "framer-motion/client";

const projects = [
  {
    title: "Depofibra",
    category: "LANDING WEB / INDUSTRIAL",
    description:
      "Diseño y desarrollo de landing page corporativa de alta conversión optimizada para posicionamiento SEO nacional en el sector de depósitos industriales y de poliéster en España.",
    tags: ["HTML", "CSS", "JavaScript", "SEO Local y Nacional"],
    image: "/webs_images/depofibra_sc.webp",
    link: "https://depofibra.com",
    reverse: true,
  },
  {
    title: "Pizzas a Todo Gas",
    category: "LANDING WEB / HOSTELERÍA SEVILLA",
    description:
      "Plataforma a medida para pizzería local en Sevilla. Incluye carta digital interactiva optimizada para móviles y una estrategia de SEO local para maximizar conversiones y pedidos a domicilio.",
    tags: ["Diseño UI/UX", "Carta online", "Desarrollo Web", "SEO Local"],
    image: "/webs_images/pizzasatodogas_sc.webp",
    link: "https://pizzasatodogas.com",
    reverse: false,
  },
  {
    title: "Daniel Rayo Portfolio",
    category: "DIGITAL PORTFOLIO / 3D INTERACTIVO",
    description:
      "Portfolio digital interactivo en 3D para un artista digital en Madrid. Sistema de alto rendimiento visual optimizado para lograr alcance y captación de clientes de perfil corporativo.",
    tags: ["Next.js", "Supabase", "Animaciones 3D", "Portfolio"],
    image: "/webs_images/danirayo3d_sc.webp",
    link: "https://danirayo3d.es",
    reverse: true,
  },
  {
    title: "Eva Torres Moda",
    category: "CATÁLOGO WEB / COMERCIO LOCAL",
    description:
      "Creación de catálogo web interactivo para una tienda física local de moda en Arahal (Sevilla). Estrategia de digitalización de comercio local para posicionar sus colecciones en toda Andalucía.",
    tags: ["Astro", "Tailwind CSS", "Sanity", "Comercio Local"],
    image: "/webs_images/evatorresmoda_sc.webp",
    link: "https://evatorresmoda.com",
    reverse: false,
  },
  {
    title: "Xollazo",
    category: "E-COMMERCE NACIONAL / SHOPIFY",
    description:
      "Plataforma de comercio electrónico en Shopify orientada a la venta minorista nacional en toda España, con integraciones logísticas automatizadas y SEO técnico optimizado para la conversión.",
    tags: ["Shopify", "Liquids Personalizados", "SEO", "Venta Nacional"],
    image: "/webs_images/xollazo_sc.webp",
    link: "https://xollazo.com",
    reverse: true,
  },
  {
    title: "GRXParts",
    category: "E-COMMERCE INTERNACIONAL / SHOPIFY",
    description:
      "Desarrollo de tienda online internacional en Shopify especializada en accesorios y aerodinámica deportiva para vehículos, optimizada para ventas multilingües y multidivisa en España, Latinoamérica y Europa.",
    tags: ["Shopify", "Diseño UI/UX", "SEO Internacional", "E-commerce"],
    image: "/webs_images/grxparts.webp",
    link: "https://grxparts.com",
    reverse: false,
  },
];
---

<Layout pageKey="proyectos">
  <Header />

  <main>
    <section class="page-header">
      <div class="container">
        <div class="page-header-content fade-in-up">
          <span class="subtitle">CASOS DE ÉXITO</span>

          <h1 class="page-title">
            Experiencia <br />
            <span class="text-gradient">Digital.</span>
          </h1>

          <p class="page-description">
            Proyectos de diseño web, desarrollo de software y posicionamiento SEO local y nacional. Impulsamos marcas y negocios en Sevilla, Andalucía y toda España y Portugal con soluciones digitales de alto impacto.
          </p>
        </div>
      </div>
      <div class="header-glow"></div>
    </section>

    <section class="work-section">
      <div class="container">
        <div class="project-list">
          {projects.map((project) => <ProjectCard {...project} />)}
        </div>
      </div>
    </section>

    <section class="project-cta fade-in-up">
      <div class="container">
        <div class="cta-box">
          <h2>¿Listo para empezar el tuyo?</h2>
          <p>Transformamos tus ideas en productos digitales de alto impacto.</p>
          <a href="/contacto" class="btn-primary">Iniciar Proyecto</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* Estilos Específicos de Página */
  main {
    position: relative;
    overflow: hidden;
    width: 100%; /* Blindaje contra scroll horizontal */
  }

  .container {
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* Page Header Styles */
  .page-header {
    padding: 180px 0 100px;
    position: relative;
  }

  .page-header-content {
    max-width: 800px;
    opacity: 0;
    transform: translateY(30px);
  }

  .subtitle {
    font-family: "Syne", sans-serif;
    font-size: 0.9rem;
    letter-spacing: 3px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin-bottom: 20px;
    display: block;
    font-weight: 700;
  }

  .page-title {
    font-family: "Syne", sans-serif;
    /* CLAVE: clamp ajustado para móviles (min 2.25rem) */
    font-size: clamp(2.25rem, 7vw, 6rem);
    line-height: 1.1;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 30px;

    /* ESTÉTICA: Balanceo de texto para evitar palabras sueltas */
    text-wrap: balance;
    max-width: 100%;
  }

  .text-gradient {
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 600px;
  }

  .header-glow {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      rgba(168, 85, 247, 0.15) 0%,
      rgba(0, 0, 0, 0) 70%
    );
    pointer-events: none;
    z-index: -1;
  }

  /* Work Section */
  .work-section {
    padding: 50px 0 150px;
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: 150px; /* Separación amplia en escritorio */
  }

  /* CTA Section */
  .project-cta {
    padding-bottom: 150px;
    text-align: center;
  }

  .cta-box {
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03) 0%,
      rgba(255, 255, 255, 0.01) 100%
    );
    border: 1px solid var(--border-color);
    padding: 80px 20px;
    border-radius: 20px;
    position: relative;
    overflow: hidden;
  }

  .cta-box h2 {
    font-family: "Syne", sans-serif;
    font-size: clamp(2rem, 5vw, 3rem); /* Responsivo */
    margin-bottom: 20px;
    color: var(--white);
  }

  .cta-box p {
    color: var(--text-muted);
    margin-bottom: 40px;
    font-size: 1.1rem;
  }

  .btn-primary {
    display: inline-block;
    padding: 15px 40px;
    background: var(--white);
    color: var(--bg-color);
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 768px) {
    .page-header {
      padding: 130px 0 60px; /* Menos padding superior */
    }

    .project-list {
      /* MEJORA: Reducimos el gap drásticamente en móvil para mejorar UX */
      gap: 60px;
    }

    .cta-box {
      padding: 50px 20px; /* Padding interno reducido */
    }
  }
</style>

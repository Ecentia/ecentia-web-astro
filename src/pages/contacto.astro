---
// src/pages/contacto.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ContactComponent from '../components/Contact.astro'; // Reutilizamos el potente componente
import Footer from '../components/Footer.astro';
---

<Layout pageKey="contacto">
    <Header />
    
    <main>
        <section class="contact-page-header">
            <div class="container">
                <h1 class="page-title">Hablemos de tu <br><span class="text-gradient">siguiente paso.</span></h1>
            </div>
        </section>

        <div class="contact-wrapper-page">
            <ContactComponent />
        </div>
    </main>

    <Footer />
</Layout>

<style>
    main {
        position: relative;
        overflow: hidden;
    }

    .container {
        width: 100%;
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 0 var(--gutter);
    }

    .contact-page-header {
        padding: 180px 0 40px;
        text-align: center;
    }

    .page-title {
        font-family: 'Syne', sans-serif;
        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 1.1;
        font-weight: 800;
        color: var(--white);
    }

    .text-gradient {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }
    
    /* Ajuste para que el componente Contact no tenga doble padding superior excesivo */
    .contact-wrapper-page :global(.contact-section) {
        padding-top: 40px;
        background: transparent; /* Para que se funda con el fondo si es necesario */
    }
</style>
---
// src/pages/contacto.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contacto | Ecentia">
    <Header />
    
    <main>
        <section class="contact-page">
            <div class="container">
                <div class="contact-grid">
                    
                    <div class="contact-info fade-in-up">
                        <span class="subtitle">CONTACTO</span>
                        <h1 class="page-title">Let's start a <br><span class="text-gradient">conversation.</span></h1>
                        <p class="description">
                            ¿Tienes un proyecto en mente o simplemente quieres saludar? Estamos listos para escuchar tu visión y llevarla al siguiente nivel.
                        </p>

                        <div class="info-items">
                            <div class="info-item">
                                <span class="label">UBICACIÓN</span>
                                <p>Sevilla, España</p>
                                <p class="sub-text">Disponible para todo el mundo</p>
                            </div>
                            
                            <div class="info-item">
                                <span class="label">EMAIL</span>
                                <a href="mailto:ecentiaseo@gmail.com" class="link">ecentiaseo@gmail.com</a>
                            </div>

                            <div class="info-item">
                                <span class="label">REDES SOCIALES</span>
                                <div class="social-links">
                                    <a href="#" class="social-link">LinkedIn <i class="fas fa-arrow-right"></i></a>
                                    <a href="#" class="social-link">Instagram <i class="fas fa-arrow-right"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="contact-form-wrapper fade-in-up">
                        <form class="main-form">
                            <div class="form-group">
                                <label for="name">Nombre</label>
                                <input type="text" id="name" name="name" placeholder="Tu nombre" required>
                            </div>

                            <div class="form-group">
                                <label for="email">Email</label>
                                <input type="email" id="email" name="email" placeholder="hola@ejemplo.com" required>
                            </div>

                            <div class="form-group">
                                <label for="subject">Asunto</label>
                                <select id="subject" name="subject">
                                    <option value="" disabled selected>¿En qué podemos ayudarte?</option>
                                    <option value="web">Diseño & Desarrollo Web</option>
                                    <option value="marketing">Estrategia de Marketing</option>
                                    <option value="ecommerce">E-Commerce</option>
                                    <option value="other">Otro</option>
                                </select>
                            </div>

                            <div class="form-group">
                                <label for="message">Mensaje</label>
                                <textarea id="message" name="message" rows="5" placeholder="Cuéntanos sobre tu proyecto..." required></textarea>
                            </div>

                            <div class="form-checkbox">
                                <input type="checkbox" id="privacy" required>
                                <label for="privacy">He leído y acepto la <a href="/legal/politica-privacidad">política de privacidad</a>.</label>
                            </div>

                            <button type="submit" class="submit-btn">
                                <span>Enviar Mensaje</span>
                                <i class="fas fa-paper-plane"></i>
                            </button>
                        </form>
                    </div>

                </div>
            </div>
            
            <div class="contact-glow"></div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
    main {
        padding-top: 100px;
        position: relative;
        overflow: hidden;
    }

    .container {
        width: 100%;
        max-width: var(--container-width);
        margin: 0 auto;
        padding: 0 var(--gutter);
    }

    .contact-page {
        padding: 80px 0 150px;
        position: relative;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 80px;
        align-items: start;
    }

    /* Estilos Columna Izquierda */
    .subtitle {
        font-family: 'Syne', sans-serif;
        font-size: 0.9rem;
        letter-spacing: 3px;
        color: var(--accent-color);
        text-transform: uppercase;
        margin-bottom: 20px;
        display: block;
        font-weight: 700;
    }

    .page-title {
        font-family: 'Syne', sans-serif;
        font-size: clamp(3rem, 6vw, 5rem);
        line-height: 1.1;
        font-weight: 800;
        color: var(--white);
        margin-bottom: 30px;
    }

    .text-gradient {
        background: var(--primary-gradient);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .description {
        font-size: 1.2rem;
        line-height: 1.6;
        color: var(--text-muted);
        margin-bottom: 60px;
        max-width: 500px;
    }

    .info-items {
        display: flex;
        flex-direction: column;
        gap: 40px;
    }

    .info-item .label {
        font-family: 'Syne', sans-serif;
        font-size: 0.8rem;
        color: var(--gray);
        letter-spacing: 1px;
        margin-bottom: 10px;
        display: block;
        text-transform: uppercase;
    }

    .info-item p, .info-item a {
        font-size: 1.2rem;
        color: var(--white);
        text-decoration: none;
    }

    .info-item .sub-text {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-top: 5px;
    }

    .info-item .link:hover {
        color: var(--accent-color);
        transition: color 0.3s;
    }

    .social-links {
        display: flex;
        gap: 20px;
    }

    .social-link {
        font-size: 1rem;
        color: var(--white);
        text-decoration: none;
        border-bottom: 1px solid rgba(255,255,255,0.2);
        padding-bottom: 5px;
        transition: all 0.3s;
    }

    .social-link:hover {
        border-color: var(--accent-color);
        color: var(--accent-color);
    }

    .social-link i {
        font-size: 0.8rem;
        margin-left: 5px;
        transform: rotate(-45deg);
        transition: transform 0.3s;
    }

    .social-link:hover i {
        transform: rotate(0deg);
    }

    /* Estilos Columna Derecha (Formulario) */
    .contact-form-wrapper {
        background: rgba(255, 255, 255, 0.02);
        padding: 50px;
        border-radius: 20px;
        border: 1px solid var(--border-color);
        backdrop-filter: blur(10px);
    }

    .main-form {
        display: flex;
        flex-direction: column;
        gap: 25px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .form-group label {
        font-size: 0.9rem;
        color: var(--gray);
    }

    .form-group input, 
    .form-group textarea,
    .form-group select {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 15px;
        border-radius: 8px;
        color: var(--white);
        font-family: 'Inter', sans-serif;
        font-size: 1rem;
        transition: all 0.3s ease;
        outline: none;
    }

    .form-group input:focus, 
    .form-group textarea:focus,
    .form-group select:focus {
        border-color: var(--accent-color);
        background: rgba(168, 85, 247, 0.05);
    }

    .form-checkbox {
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 0.9rem;
        color: var(--text-muted);
    }

    .form-checkbox a {
        color: var(--white);
        text-decoration: underline;
    }

    .submit-btn {
        margin-top: 10px;
        padding: 18px 30px;
        background: var(--white);
        color: var(--bg-color);
        border: none;
        border-radius: 50px;
        font-weight: 700;
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: all 0.3s ease;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 255, 255, 0.1);
    }

    /* Glow Effect */
    .contact-glow {
        position: absolute;
        top: 10%;
        right: -10%;
        width: 600px;
        height: 600px;
        background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, rgba(0,0,0,0) 70%); /* Cyan tint */
        pointer-events: none;
        z-index: -1;
    }

    @media (max-width: 900px) {
        .contact-grid {
            grid-template-columns: 1fr;
            gap: 60px;
        }
        
        .contact-form-wrapper {
            padding: 30px;
        }

        .page-title {
            font-size: 3rem;
        }
    }
</style>
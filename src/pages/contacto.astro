---
// src/pages/contacto.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ContactComponent from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
---

<Layout pageKey="contacto">
  <Header />

  <main>
    <!-- ELIMINAMOS el header gigante que se ve mal -->
    <div class="contact-wrapper-page">
      <ContactComponent />
    </div>
  </main>

  <Footer />
</Layout>

<style>
  main {
    position: relative;
    overflow: hidden;
    width: 100%;
    /* Añadimos padding top para compensar el header fijo */
    padding-top: 100px;
  }

  .contact-wrapper-page {
    padding-bottom: 50px;
  }

  /* El componente Contact ya tiene su propio header interno */
  .contact-wrapper-page :global(.contact-section) {
    padding-top: 20px;
    background: transparent;
  }

  @media (max-width: 768px) {
    main {
      padding-top: 80px;
    }
  }
</style>

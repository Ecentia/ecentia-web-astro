---
// src/pages/servicios.astro
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ServicesComponent from '../components/Services.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout pageKey="servicios">
    <Header />
    
    <main>
        <section class="page-header services-header">
            <div class="container">
                <div class="page-header-content fade-in-up">
                    <span class="subtitle">SERVICIOS DIGITALES Y CONSULTORÍA</span>
              
                    <h1 class="page-title">Ingeniería <br> <span class="text-gradient">Digital.</span></h1>
                    
                    <p class="page-description">
                        Diseño web, desarrollo a medida y SEO estratégico. Creamos soluciones y productos digitales premium en Sevilla, Málaga y a nivel nacional para empresas y marcas que buscan acelerar su crecimiento mediante la tecnología y la optimización en Google.
                    </p>
                </div>
            </div>
            <div class="header-glow services-glow"></div>
        </section>

        <div class="services-wrapper fade-in-up">
            <ServicesComponent />
        </div>
        
        <section class="capabilities-break">
            <div class="container">
                <div class="capabilities-grid">
                    <div class="cap-item">
                        <span class="cap-number">01</span>
                        <h3>Estrategia</h3>
                        <p>Auditoría SEO técnica, optimización en motores de búsqueda, análisis de competencia local/nacional y planes de negocio orientados al ROI.</p>
                    </div>
                    <div class="cap-item">
                        <span class="cap-number">02</span>
                        <h3>Diseño</h3>
                        <p>Sistemas de diseño a medida (UI/UX), interfaces premium, branding corporativo y experiencias de usuario optimizadas para conversión.</p>
                    </div>
                    <div class="cap-item">
                        <span class="cap-number">03</span>
                        <h3>Desarrollo</h3>
                        <p>Desarrollo web a medida con Astro, Next.js y React, implantación y optimización de e-commerce Shopify y optimización Core Web Vitals.</p>
                    </div>
                </div>
            </div>
        </section>

        <CTA />
    </main>

    <Footer />
</Layout>

<style>
    main { 
        /* Importante para evitar scroll horizontal fantasma */
        overflow: hidden;
        width: 100%;
    }

    .container { 
        width: 100%; 
        max-width: var(--container-width); 
        margin: 0 auto; 
        padding: 0 var(--gutter);
    }
    
    /* Page Header */
    .page-header { 
        padding: 180px 0 80px;
        position: relative; 
    }

    .subtitle { 
        font-family: 'Syne', sans-serif; 
        font-size: 0.9rem; 
        letter-spacing: 3px; 
        color: var(--accent-color); 
        text-transform: uppercase;
        margin-bottom: 20px; 
        display: block; 
        font-weight: 700; 
    }

    .page-title { 
        font-family: 'Syne', sans-serif; 
        /* AJUSTE CLAVE: clamp(mínimo, ideal, máximo) */
        /* 2.25rem es suficientemente pequeño para que 'Ingeniería' quepa en pantallas estrechas */
        /* 7vw escala suavemente en tablets */
        font-size: clamp(2.25rem, 7vw, 6rem);
        
        line-height: 1.1; 
        font-weight: 800; 
        color: var(--white); 
        margin-bottom: 30px; 
        
        /* ESTÉTICA: Evita que queden palabras "huerfanas" o una sola palabra por línea si es posible */
        text-wrap: balance; 
        max-width: 100%;
    }

    .text-gradient { 
        background: var(--primary-gradient); 
        -webkit-background-clip: text; 
        -webkit-text-fill-color: transparent;
    }

    .page-description { 
        font-size: 1.2rem; 
        line-height: 1.6; 
        color: var(--text-muted); 
        max-width: 650px;
    }

    /* Glow */
    .services-glow { 
        position: absolute; 
        top: -30%; 
        left: -10%; 
        width: 700px;
        height: 700px; 
        background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(0,0,0,0) 70%); 
        pointer-events: none; 
        z-index: -1;
    }

    .services-wrapper { 
        position: relative; 
        z-index: 2;
    }

    /* Capabilities */
    .capabilities-break { 
        padding: 100px 0; 
        border-top: 1px solid rgba(255,255,255,0.05);
        border-bottom: 1px solid rgba(255,255,255,0.05); 
        background: rgba(255,255,255,0.01); 
    }

    .capabilities-grid { 
        display: grid; 
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); 
        gap: 60px;
    }

    .cap-item h3 { 
        font-family: 'Syne', sans-serif; 
        font-size: 2rem; 
        color: var(--white); 
        margin-bottom: 15px;
    }

    .cap-number { 
        font-family: 'Syne', sans-serif; 
        font-size: 1rem; 
        color: var(--accent-color); 
        display: block; 
        margin-bottom: 10px; 
        font-weight: 700;
    }

    .cap-item p { 
        color: var(--text-muted); 
        line-height: 1.6;
    }

    @media (max-width: 768px) {
        .page-header { 
            padding: 130px 0 50px; 
        }
        
        .capabilities-grid { 
            gap: 40px;
            /* En móvil forzamos 1 columna para que los textos tengan espacio */
            grid-template-columns: 1fr;
        }
        
        .page-title {
           /* Ajuste fino para móviles muy pequeños */
           margin-bottom: 20px;
        }
    }
</style>
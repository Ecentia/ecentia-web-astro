---
// src/pages/blog/index.astro
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
import BlogCard from "../../components/BlogCard.astro";
import Footer from "../../components/Footer.astro";
import { blogPosts } from "../../data/blog";

// Obtener todas las categorías únicas para el filtro
const allTags = ['Todos', ...new Set(blogPosts.flatMap(post => post.tags))];

// Ordenar posts de más reciente a más antiguo
const sortedPosts = [...blogPosts].sort((a, b) => 
  new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime()
);
---

<Layout pageKey="blog">
  <Header />

  <main>
    <section class="page-header blog-header">
      <div class="container">
        <div class="page-header-content fade-in-up">
          <span class="subtitle">GUÍAS, SEO Y MARKETING DIGITAL</span>
          <h1 class="page-title">
            Blog &
            <br />
            <span class="text-gradient">Recursos.</span>
          </h1>
          <p class="page-description">
            Guías prácticas sobre <strong>diseño web</strong>, <strong>posicionamiento en Google</strong> y <strong>automatización con IA</strong>. Todo lo que necesitas para atraer más clientes a tu negocio en España.
          </p>
        </div>
      </div>
      <div class="header-glow blog-glow"></div>
    </section>

    <!-- Barra de búsqueda y Filtros -->
    <section class="filter-section fade-in-up">
      <div class="container">
        <div class="filter-wrapper">
          <div class="search-box">
            <i class="fas fa-search search-icon"></i>
            <input 
              type="text" 
              id="blog-search" 
              placeholder="Buscar artículos por título o palabra clave..." 
              aria-label="Buscar artículos en el blog"
            />
          </div>
          <div class="category-filters" role="tablist" aria-label="Filtrar por categoría">
            {allTags.map((tag, idx) => (
              <button 
                class:list={["filter-btn magnet-target", { active: idx === 0 }]} 
                data-filter={tag === 'Todos' ? 'all' : tag}
                role="tab"
                aria-selected={idx === 0 ? "true" : "false"}
              >
                {tag}
              </button>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Listado de Artículos -->
    <section class="blog-list-section">
      <div class="container">
        <div class="blog-grid" id="blog-grid">
          {sortedPosts.map(post => (
            <div class="blog-grid-item" data-tags={post.tags.join(',')} data-title={post.title.toLowerCase()} data-desc={post.description.toLowerCase()}>
              <BlogCard post={post} />
            </div>
          ))}
        </div>
        
        <!-- Estado Vacío -->
        <div class="empty-state" id="empty-state" style="display: none;">
          <i class="fas fa-search-minus empty-icon"></i>
          <h3>No se encontraron artículos</h3>
          <p>Prueba a buscar con otros términos o seleccionando otra categoría.</p>
          <button class="btn-reset" id="reset-search">Restablecer filtros</button>
        </div>
      </div>
    </section>

    <!-- CTA Section -->
    <section class="project-cta fade-in-up">
      <div class="container">
        <div class="cta-box">
          <h2>¿Quieres que tu negocio aparezca el primero en Google?</h2>
          <p>Diseñamos estrategias de SEO local y nacional, desarrollo web a medida y automatizaciones que convierten visitas en clientes. Cuéntanos tu proyecto.</p>
          <a href="/contacto" class="btn-primary magnet-target">Pide tu presupuesto gratis</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const searchInput = document.getElementById("blog-search") as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll(".filter-btn");
    const blogItems = document.querySelectorAll(".blog-grid-item");
    const emptyState = document.getElementById("empty-state");
    const resetBtn = document.getElementById("reset-search");
    const grid = document.getElementById("blog-grid");

    if (!searchInput || !blogItems.length) return;

    let currentFilter = "all";
    let searchQuery = "";

    const filterPosts = () => {
      let visibleCount = 0;

      blogItems.forEach((item) => {
        const htmlItem = item as HTMLElement;
        const tags = htmlItem.dataset.tags?.split(",") || [];
        const title = htmlItem.dataset.title || "";
        const desc = htmlItem.dataset.desc || "";

        const matchesFilter = currentFilter === "all" || tags.includes(currentFilter);
        const matchesSearch = title.includes(searchQuery) || desc.includes(searchQuery);

        if (matchesFilter && matchesSearch) {
          htmlItem.style.display = "block";
          // Pequeño retardo para reiniciar animaciones
          setTimeout(() => {
            htmlItem.style.opacity = "1";
            htmlItem.style.transform = "translateY(0)";
          }, 50);
          visibleCount++;
        } else {
          htmlItem.style.opacity = "0";
          htmlItem.style.transform = "translateY(15px)";
          htmlItem.style.display = "none";
        }
      });

      if (grid && emptyState) {
        if (visibleCount === 0) {
          grid.style.display = "none";
          emptyState.style.display = "flex";
        } else {
          grid.style.display = "grid";
          emptyState.style.display = "none";
        }
      }
    };

    // Evento de Búsqueda
    searchInput.addEventListener("input", (e) => {
      const target = e.target as HTMLInputElement;
      searchQuery = target.value.trim().toLowerCase();
      filterPosts();
    });

    // Evento de Botón de Filtrado
    filterButtons.forEach((btn) => {
      btn.addEventListener("click", (e) => {
        // Remover clase activo de todos
        filterButtons.forEach(b => {
          b.classList.remove("active");
          b.setAttribute("aria-selected", "false");
        });

        const currentBtn = e.currentTarget as HTMLButtonElement;
        currentBtn.classList.add("active");
        currentBtn.setAttribute("aria-selected", "true");

        currentFilter = currentBtn.dataset.filter || "all";
        filterPosts();
      });
    });

    // Resetear filtros
    resetBtn?.addEventListener("click", () => {
      searchInput.value = "";
      searchQuery = "";
      currentFilter = "all";
      
      filterButtons.forEach((b, idx) => {
        if (idx === 0) {
          b.classList.add("active");
          b.setAttribute("aria-selected", "true");
        } else {
          b.classList.remove("active");
          b.setAttribute("aria-selected", "false");
        }
      });

      filterPosts();
    });
  });
</script>

<style>
  main {
    position: relative;
    overflow: hidden;
    width: 100%;
  }

  .container {
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  /* Page Header */
  .page-header {
    padding: 180px 0 60px;
    position: relative;
  }

  .page-header-content {
    max-width: 800px;
    opacity: 0;
    transform: translateY(30px);
  }

  .subtitle {
    font-family: "Syne", sans-serif;
    font-size: 0.9rem;
    letter-spacing: 3px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin-bottom: 20px;
    display: block;
    font-weight: 700;
  }

  .page-title {
    font-family: "Syne", sans-serif;
    font-size: clamp(2.25rem, 7vw, 6rem);
    line-height: 1.1;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 30px;
    text-wrap: balance;
  }

  .text-gradient {
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .page-description {
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 650px;
  }

  .blog-glow {
    position: absolute;
    top: -20%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      rgba(99, 102, 241, 0.12) 0%,
      rgba(0, 0, 0, 0) 70%
    );
    pointer-events: none;
    z-index: -1;
  }

  /* Filtros y Búsqueda */
  .filter-section {
    padding-bottom: 40px;
  }

  .filter-wrapper {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-bottom: 20px;
  }

  @media (min-width: 992px) {
    .filter-wrapper {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }
  }

  .search-box {
    position: relative;
    width: 100%;
    max-width: 450px;
  }

  .search-icon {
    position: absolute;
    left: 20px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--gray);
    font-size: 0.95rem;
    pointer-events: none;
  }

  .search-box input {
    width: 100%;
    padding: 16px 20px 16px 50px;
    background: var(--input-bg);
    border: 1px solid var(--border-color);
    border-radius: 50px;
    color: var(--white);
    font-family: 'Inter', sans-serif;
    font-size: 0.95rem;
    transition: all 0.3s ease;
  }

  .search-box input:focus {
    outline: none;
    border-color: var(--accent-color);
    box-shadow: 0 0 15px rgba(168, 85, 247, 0.15);
    background: rgba(255, 255, 255, 0.07);
  }

  .category-filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border-color);
    color: var(--text-muted);
    padding: 10px 22px;
    border-radius: 50px;
    font-family: 'Syne', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .filter-btn:hover {
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.3);
    background: rgba(255, 255, 255, 0.05);
  }

  .filter-btn.active {
    background: var(--white);
    color: var(--bg-color);
    border-color: var(--white);
    box-shadow: 0 5px 15px rgba(255, 255, 255, 0.1);
  }

  /* Listado */
  .blog-list-section {
    padding: 30px 0 100px;
  }

  .blog-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  @media (min-width: 640px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .blog-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 40px;
    }
  }

  .blog-grid-item {
    transition: opacity 0.4s ease, transform 0.4s ease;
  }

  /* Estado vacío */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    text-align: center;
    border: 1px dashed var(--border-color);
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.01);
  }

  .empty-icon {
    font-size: 3rem;
    color: var(--text-muted);
    margin-bottom: 20px;
    opacity: 0.5;
  }

  .empty-state h3 {
    font-family: 'Syne', sans-serif;
    font-size: 1.5rem;
    margin-bottom: 10px;
    color: var(--white);
  }

  .empty-state p {
    color: var(--text-muted);
    margin-bottom: 25px;
    max-width: 400px;
  }

  .btn-reset {
    background: var(--white);
    color: var(--bg-color);
    border: none;
    padding: 12px 28px;
    border-radius: 50px;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.9rem;
    cursor: pointer;
    transition: transform 0.3s ease;
  }

  .btn-reset:hover {
    transform: translateY(-2px);
  }

  /* CTA Box */
  .project-cta {
    padding-bottom: 150px;
    text-align: center;
  }

  .cta-box {
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03) 0%,
      rgba(255, 255, 255, 0.01) 100%
    );
    border: 1px solid var(--border-color);
    padding: 80px 20px;
    border-radius: 20px;
    position: relative;
    overflow: hidden;
  }

  .cta-box h2 {
    font-family: "Syne", sans-serif;
    font-size: clamp(2rem, 5vw, 3rem);
    margin-bottom: 20px;
    color: var(--white);
  }

  .cta-box p {
    color: var(--text-muted);
    margin-bottom: 40px;
    font-size: 1.1rem;
  }

  .btn-primary {
    display: inline-block;
    padding: 15px 40px;
    background: var(--white);
    color: var(--bg-color);
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px;
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(255, 255, 255, 0.1);
  }

  @media (max-width: 768px) {
    .page-header {
      padding: 130px 0 40px;
    }
    .cta-box {
      padding: 50px 20px;
    }
  }
</style>

    margin-top: 10px;
    font-weight: 500;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .copied-toast.show {
    opacity: 1;
  }

  /* Content area */
  .article-content {
    order: 1;
    max-width: 800px;
  }

  @media (min-width: 992px) {
    .article-content {
      order: 2;
    }
  }

  .article-content p {
    font-size: 1.15rem;
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 25px;
  }

  .article-content h2 {
    font-family: 'Syne', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--white);
    margin: 50px 0 20px;
    line-height: 1.25;
  }

  .article-content h3 {
    font-family: 'Syne', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--white);
    margin: 35px 0 15px;
    line-height: 1.3;
  }

  .article-content blockquote {
    border-left: 4px solid var(--accent-color);
    background: rgba(168, 85, 247, 0.03);
    padding: 25px 30px;
    border-radius: 0 16px 16px 0;
    margin: 35px 0;
  }

  .article-content blockquote p {
    font-style: italic;
    margin-bottom: 0;
    font-size: 1.2rem;
    line-height: 1.6;
    color: var(--white);
  }

  .article-content ul {
    margin: 0 0 30px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .article-content ul li {
    font-size: 1.1rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.8);
  }

  /* Code block */
  .code-block-wrapper {
    margin: 35px 0;
    background: rgba(0, 0, 0, 0.3);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    overflow: hidden;
  }

  .code-lang {
    background: rgba(255, 255, 255, 0.03);
    padding: 8px 20px;
    font-size: 0.75rem;
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--accent-color);
    border-bottom: 1px solid var(--border-color);
    letter-spacing: 1px;
  }

  .code-block-wrapper pre {
    padding: 20px;
    overflow-x: auto;
    margin: 0;
  }

  .code-block-wrapper code {
    font-family: monospace;
    font-size: 0.95rem;
    color: rgba(255, 255, 255, 0.9);
  }

  /* Related section */
  .related-posts-section {
    padding: 80px 0;
    border-top: 1px solid var(--border-color);
  }

  .section-title {
    font-family: 'Syne', sans-serif;
    font-size: 2.2rem;
    font-weight: 800;
    margin-bottom: 40px;
    color: var(--white);
  }

  .related-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 30px;
  }

  @media (min-width: 768px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .related-card {
    background: rgba(255, 255, 255, 0.01);
    border: 1px solid var(--border-color);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    display: flex;
    flex-direction: column;
    transition: all 0.3s ease;
  }

  .related-card:hover {
    transform: translateY(-4px);
    border-color: rgba(168, 85, 247, 0.3);
    box-shadow: 0 10px 20px rgba(168, 85, 247, 0.03);
  }

  .related-img-wrapper {
    width: 100%;
    aspect-ratio: 16/7;
    overflow: hidden;
    border-bottom: 1px solid var(--border-color);
  }

  .related-img-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .related-card:hover img {
    transform: scale(1.03);
  }

  .related-content {
    padding: 25px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .related-tag {
    font-family: 'Syne', sans-serif;
    font-weight: 700;
    font-size: 0.75rem;
    color: var(--accent-color);
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .related-content h3 {
    font-family: 'Syne', sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--white);
    line-height: 1.35;
    margin: 0;
  }

  .related-link {
    font-family: 'Syne', sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--white);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    transition: color 0.3s ease;
  }

  .related-link i {
    font-size: 0.75rem;
    transition: transform 0.3s ease;
  }

  .related-card:hover .related-link {
    color: var(--accent-color);
  }

  .related-card:hover .related-link i {
    transform: translateX(4px);
  }

  /* CTA */
  .project-cta {
    padding: 80px 0 150px;
    text-align: center;
  }

  .cta-box {
    background: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.03) 0%,
      rgba(255, 255, 255, 0.01) 100%

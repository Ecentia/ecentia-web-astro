---
// src/pages/404.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="404: Página no encontrada | Ecentia" description="La página que buscas no existe o ha sido movida." noindex={true}>
  <Header />

  <main>
    <section class="error-section">
      <div class="container">
        <div class="error-content fade-in-up">
          <span class="subtitle">ERROR 404</span>

          <h1 class="error-code" id="error-code-heading">404</h1>

          <h2 class="error-title">
            Parece que te <br />
            <span class="text-gradient">has perdido.</span>
          </h2>

          <p class="error-description">
            La página que buscas no existe, ha cambiado de dirección o no está disponible temporalmente.
          </p>

          <div class="error-actions">
            <a href="/" class="btn-primary" id="btn-back-home">Volver al Inicio</a>
            <a href="/contacto" class="btn-secondary" id="btn-goto-contact">Contacto</a>
          </div>
        </div>
      </div>
      <div class="header-glow"></div>
      <div class="glow-orb"></div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  main {
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: calc(100vh - 150px); /* Asegurar que ocupe casi toda la pantalla */
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .container {
    width: 100%;
    max-width: var(--container-width);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }

  .error-section {
    padding: 180px 0 120px;
    position: relative;
    width: 100%;
    text-align: center;
  }

  .error-content {
    max-width: 800px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    opacity: 0;
    transform: translateY(30px);
  }

  .subtitle {
    font-family: "Syne", sans-serif;
    font-size: 0.9rem;
    letter-spacing: 3px;
    color: var(--accent-color);
    text-transform: uppercase;
    margin-bottom: 20px;
    display: block;
    font-weight: 700;
  }

  .error-code {
    font-family: "Syne", sans-serif;
    font-size: clamp(6rem, 15vw, 12rem);
    line-height: 0.9;
    font-weight: 800;
    margin-bottom: 10px;
    background: linear-gradient(180deg, var(--white) 30%, rgba(255, 255, 255, 0.1) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 30px rgba(168, 85, 247, 0.2));
    animation: pulse 4s infinite ease-in-out;
  }

  .error-title {
    font-family: "Syne", sans-serif;
    font-size: clamp(2.25rem, 6vw, 4rem);
    line-height: 1.1;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 20px;
    text-wrap: balance;
  }

  .text-gradient {
    background: var(--primary-gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .error-description {
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 550px;
    margin-bottom: 40px;
    text-wrap: balance;
  }

  .error-actions {
    display: flex;
    gap: 20px;
    justify-content: center;
    align-items: center;
  }

  .btn-primary {
    display: inline-block;
    padding: 15px 40px;
    background: var(--white);
    color: var(--bg-color);
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(255, 255, 255, 0.1);
  }

  .btn-secondary {
    display: inline-block;
    padding: 14px 38px;
    background: transparent;
    color: var(--white);
    border: 1px solid rgba(255, 255, 255, 0.2);
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px;
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
  }

  .btn-secondary:hover {
    transform: translateY(-2px);
    border-color: var(--accent-color);
    background: rgba(168, 85, 247, 0.05);
  }

  .header-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      rgba(168, 85, 247, 0.12) 0%,
      rgba(0, 0, 0, 0) 70%
    );
    pointer-events: none;
    z-index: -1;
  }

  .glow-orb {
    position: absolute;
    top: 20%;
    left: 25%;
    width: 300px;
    height: 300px;
    background: radial-gradient(
      circle,
      rgba(99, 102, 241, 0.08) 0%,
      rgba(0, 0, 0, 0) 75%
    );
    filter: blur(40px);
    pointer-events: none;
    z-index: -1;
  }

  @keyframes pulse {
    0%, 100% {
      transform: scale(1);
      filter: drop-shadow(0 0 30px rgba(168, 85, 247, 0.2));
    }
    50% {
      transform: scale(1.02);
      filter: drop-shadow(0 0 50px rgba(168, 85, 247, 0.35));
    }
  }

  @media (max-width: 768px) {
    .error-section {
      padding: 140px 0 80px;
    }

    .error-actions {
      flex-direction: column;
      width: 100%;
      max-width: 300px;
      gap: 15px;
    }

    .btn-primary, .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
